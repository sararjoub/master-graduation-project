@section Head {
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - Skills Swap</title>

    <link rel="stylesheet" href="css/shared.css">
    <link rel="stylesheet" href="css/welcome.css">
<script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}


    <!--  Confetti Container  -->
    <div id="confetti-container"></div>

    <!--  Welcome Section  -->
    <section class="welcome-section">
        <div class="welcome-container">
            
            <!-- Success Icon -->
            <div class="welcome-icon-wrapper animate-fade-rise">
                <div class="welcome-icon">🎉</div>
                <div class="welcome-pulse"></div>
            </div>

            <!-- Header -->
            <div class="welcome-header animate-fade-rise-delay-1">
                <span class="welcome-tag">ONBOARDING COMPLETE</span>
                <h1>Welcome to Skills Swap, <span class="highlight-name" id="userNameDisplay">Ahmad</span>!</h1>
                <p>Your profile is ready. Choose your starting point; teaching a skill is optional.</p>
            </div>

            <!-- Quick Actions -->
            <div class="welcome-actions-grid animate-fade-rise-delay-2">
                <a href="categories.html" class="welcome-action-card">
                    <div class="action-icon">🔍</div>
                    <h3>Explore Skills</h3>
                    <p>Discover new skills to learn from others.</p>
                </a>
                <a href="career-path-setup.html" class="welcome-action-card">
                    <div class="action-icon">🎯</div>
                    <h3>Set Career Path</h3>
                    <p>Plan your learning journey step by step.</p>
                </a>
            </div>

            <!-- Main CTA -->
            
<div class="welcome-footer-note animate-fade-rise-delay-3" style="margin-top: 32px; text-align: center; color: var(--text-light); font-size: 14px;">
    Choose an option above to start your journey.
</div>
        </div>
    </section>

    <script src="js/welcome.js"></script>
@await Html.PartialAsync("_Footer2")
<script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
<script src="js/icon-tones.js"></script>
<script src="js/interface-polish.js"></script>
