@model VerifyEmailViewModel
@{ ViewData["BodyClass"] = "wf-page"; }
@section Head {<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Confirm your email - Skills Swap</title><link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/verify-email.css"><script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css"><link rel="stylesheet" href="css/responsive-refinements.css"><link rel="stylesheet" href="css/brand.css"><link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg"><link rel="stylesheet" href="css/interface-polish.css"><script src="js/visitor-flow.js"></script><script src="js/skill-access.js"></script>}
@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container"><div class="wf-header"><span class="wf-kicker">Skills Swap</span><h1>Confirm your email</h1><p>Your account becomes usable after a secure email-confirmation link is verified.</p></div><section class="wf-card"><h2>Check your inbox</h2><p>Check your inbox and spam folder for a time-limited confirmation link.</p>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="wf-note" role="status">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.DevelopmentConfirmationUrl)) { <div class="wf-note" role="note">Development mode: email delivery is not configured yet. Use this secure test link locally.</div><a href="@Model.DevelopmentConfirmationUrl" class="btn btn-primary">Confirm email →</a> }
<form method="post" action="/account/resend-confirmation">@Html.AntiForgeryToken()<input type="hidden" name="EmailLanguage" value="@Context.Request.Query["lang"]"><label class="form-label" for="resendEmail">Email address</label><input class="form-input" id="resendEmail" name="email" type="email" maxlength="254" required autocomplete="email"><button type="submit" class="btn btn-outline">Resend confirmation link</button></form><script src="/js/account-email-language.js" asp-append-version="true" defer></script></section></div></main>
@await Html.PartialAsync("_Footer2")
<script src="js/animations.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script><script src="js/icon-tones.js"></script><script src="js/interface-polish.js"></script>
