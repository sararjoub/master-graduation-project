@model ForgotPasswordViewModel
@{
    ViewData["BodyClass"] = "compact-auth wf-page";
}

@section Head {<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Forgot your password? - Skills Swap</title><link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/forgot-password.css"><script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}

@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container"><div class="wf-header"><span class="wf-kicker">Skills Swap</span><h1>Forgot your password?</h1><p>Request a secure link to recover access.</p></div><section class="wf-card"><h2>Account recovery</h2>
@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="wf-note" role="status">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.DevelopmentResetUrl)) { <div class="wf-note" role="note">Development mode: email delivery is not configured yet. Use this secure test link locally.</div><a class="btn btn-primary" href="@Model.DevelopmentResetUrl">Open reset link →</a> }
<form method="post" asp-action="ForgotPassword"><input type="hidden" name="EmailLanguage" value="@Context.Request.Query["lang"]"><div asp-validation-summary="ModelOnly" class="wf-errors" role="alert"></div><div class="form-group"><label class="form-label" asp-for="Email">Email address</label><input class="form-input" asp-for="Email" required autocomplete="email"><span asp-validation-for="Email" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Request reset link</button></form><script src="/js/account-email-language.js" asp-append-version="true" defer></script><a href="/login.html" class="btn btn-outline">← Back to login</a></section></div></main>
@await Html.PartialAsync("_Footer2")
<script src="js/animations.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
<script src="js/icon-tones.js"></script>
<script src="js/interface-polish.js"></script>
