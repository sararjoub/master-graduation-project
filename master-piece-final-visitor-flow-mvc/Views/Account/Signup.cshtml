@model SignupViewModel
@section Head {
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - Skills Swap</title>
    
    <!-- الملفات المشتركة -->
    <link rel="stylesheet" href="css/shared.css">
    <link rel="stylesheet" href="css/signup.css">
<script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}


    <!--  Navbar (مشترك) -->
    <nav class="navbar">
        <div class="navbar-container">
            <a href="home.html" class="navbar-logo"><span class="brand-symbol"><svg data-brand-mark viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10L3 14L7 18M3 14H15M17 6L21 10L17 14M21 10H9"/></g></svg></span><span class="brand-text"><span class="brand-wordmark" data-no-translate>Skills <span>Swap</span></span></span></a>
            <div class="navbar-links">
                <a href="home.html" class="navbar-link">Home</a>
                <a href="categories.html" class="navbar-link">Categories</a>
                <a href="home.html" class="navbar-link">How It Works</a>
                <a href="home.html#about" class="navbar-link">About</a>
            </div>
            <div class="navbar-actions">
                <button class="navbar-login" onclick="window.SitePrefs.navigate('login.html')">Login</button>
                <button class="navbar-signup">Sign Up</button>
            </div>
        </div>
    </nav>

    <!--  Sign Up Section -->
    <section class="auth-section">
        <div class="auth-container">
            
            <!--الجهة اليسار الفورم-->
            <div class="auth-form-wrapper animate-scale-in">
                <div class="auth-logo"><span class="brand-symbol"><svg data-brand-mark viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10L3 14L7 18M3 14H15M17 6L21 10L17 14M21 10H9"/></g></svg></span><span class="brand-text"><span class="brand-wordmark" data-no-translate>Skills <span>Swap</span></span></span></div>

                <form class="auth-form" id="signupForm" method="post" asp-action="Signup">
                    <div asp-validation-summary="ModelOnly" class="notification notification-error show" role="alert"></div>
                    
                    <!-- الاسم الكامل -->
                    <div class="form-group animate-fade-rise-delay-1">
                        <label class="form-label" for="fullName">Full Name</label>
                        <div class="input-with-icon">
                            <span class="input-icon">👤</span>
                            <input 
                                type="text" 
                                id="fullName" asp-for="FullName"
                                class="form-input" 
                                placeholder="Enter your full name"
                                required
                            >
                        </div>
                    </div>

                    <!-- البريد الإلكتروني -->
                    <div class="form-group animate-fade-rise-delay-1">
                        <label class="form-label" for="email">Email Address</label>
                        <div class="input-with-icon">
                            <span class="input-icon">✉️</span>
                            <input 
                                type="email" 
                                id="email" asp-for="Email"
                                class="form-input" 
                                placeholder="you@example.com"
                                required
                            >
                        </div>
                    </div>

                    <!-- كلمة المرور -->
                    <div class="form-group animate-fade-rise-delay-2">
                        <label class="form-label" for="password">Password</label>
                        <div class="input-with-icon">
                            <span class="input-icon">🔒</span>
                            <input 
                                type="password" 
                                id="password" asp-for="Password"
                                class="form-input" 
                                placeholder="Create a strong password"
                                required
                            >
                            <button type="button" class="toggle-password" id="togglePassword">👁️</button>
                        </div>
                        
                        <!-- مؤشر قوة كلمة المرور -->
                        <div class="password-strength" id="passwordStrength">
                            <div class="strength-bar">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <span class="strength-text" id="strengthText">Password strength</span>
                        </div>
                    </div>

                    <!-- تأكيد كلمة المرور -->
                    <div class="form-group animate-fade-rise-delay-2">
                        <label class="form-label" for="confirmPassword">Confirm Password</label>
                        <div class="input-with-icon">
                            <span class="input-icon">🔒</span>
                            <input 
                                type="password" 
                                id="confirmPassword" asp-for="ConfirmPassword"
                                class="form-input" 
                                placeholder="Re-enter your password"
                                required
                            >
                        </div>
                    </div>

                   

                    <!-- الموافقة على الشروط -->
                    <div class="form-group animate-fade-rise-delay-3">
                        <label class="checkbox-label">
                            <input type="checkbox" id="terms" asp-for="AcceptTerms" required>
                            <span>I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></span>
                        </label>
                    </div>

                    <!-- زر التسجيل -->
                    <button type="submit" class="btn btn-primary btn-large btn-full animate-fade-rise-delay-3">
                        Create Account →
                    </button>

                    <!-- رابط تسجيل الدخول -->
                    <p class="auth-switch animate-fade-rise-delay-3">
                        Already have an account? <a href="login.html">Login</a>
                    </p>

                </form>
            </div>

            <!--  الحهة اليمين الصوره -->
            <div class="auth-illustration animate-slide-in-right">
                <div class="illustration-content">
                    <h2>Start Your Skill Exchange Journey</h2>
                    <p>Connect with people who share your passion for learning and teaching.</p>
                
                    <img 
                        src="assests/start.png" 
                        alt="People exchanging skills"
                        class="illustration-image"
                    >
                    
                    <!-- الميزات -->
                    <ul class="illustration-features">
                        <li>
                            <span class="feature-check">✓</span>
                            <span>Free to join</span>
                        </li>
                        <li>
                            <span class="feature-check">✓</span>
                            <span>Connect with verified mentors</span>
                        </li>
                        <li>
                            <span class="feature-check">✓</span>
                            <span>Learn at your own pace</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </section>

    <script src="js/animations.js"></script>
    <script src="js/signup.js" asp-append-version="true"></script>

@await Html.PartialAsync("_Footer2")
<script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
<script src="js/icon-tones.js"></script>
<script src="js/interface-polish.js"></script>
