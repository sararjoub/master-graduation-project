@model ChangePasswordViewModel
@{ ViewData["BodyClass"] = "compact-auth wf-page"; }
@section Head {
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Change password - Skills Swap</title>
<link rel="stylesheet" href="/css/shared.css">
<link rel="stylesheet" href="/css/workflow-ui.css">
<link rel="stylesheet" href="/css/site-preferences.css">
<link rel="stylesheet" href="/css/responsive-refinements.css">
<link rel="stylesheet" href="/css/brand.css">
<link rel="stylesheet" href="/css/interface-polish.css">
<script src="/js/site-preferences-init.js"></script>
}
@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container">
    <div class="wf-header"><h1>Change password</h1></div>
    <section class="wf-card">
        @if (TempData["ChangePasswordMessage"] is string message) { <p class="wf-note" role="status">@message</p> }
        <form method="post" asp-action="ChangePassword">
            <div asp-validation-summary="All" class="wf-errors" role="alert"></div>
            <div class="form-group"><label asp-for="CurrentPassword" class="form-label">Current password</label><input asp-for="CurrentPassword" class="form-input" autocomplete="current-password" required></div>
            <div class="form-group"><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" class="form-input" autocomplete="new-password" required minlength="8"></div>
            <div class="form-group"><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password" required minlength="8"></div>
            <button type="submit" class="btn btn-primary">Change password</button>
            <a class="btn btn-outline" href="/profile.html">Back to profile</a>
        </form>
    </section>
</div></main>
@await Html.PartialAsync("_Footer2")
<script src="/js/site-ar.js"></script><script src="/js/site-preferences.js"></script><script src="/js/animations.js"></script><script src="/js/interface-polish.js"></script>
