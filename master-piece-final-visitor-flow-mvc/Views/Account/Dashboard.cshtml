@model DashboardViewModel
@{ var firstName = Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.FullName; }
@section Head {
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Dashboard - Skills Swap</title>
<link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/dashboard.css"><link rel="stylesheet" href="css/name-outline.css">
<script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css"><link rel="stylesheet" href="css/responsive-refinements.css"><link rel="stylesheet" href="css/brand.css"><link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg"><link rel="stylesheet" href="css/interface-polish.css"><script src="js/visitor-flow.js"></script><script src="js/skill-access.js"></script>}
<nav class="navbar navbar-authed"><div class="navbar-container">
<a href="home.html" class="navbar-logo"><span class="brand-symbol">↔</span><span class="brand-text"><span class="brand-wordmark" data-no-translate>Skills <span>Swap</span></span></span></a>
<div class="navbar-links"><a href="dashboard.html" class="navbar-link active">Dashboard</a><a href="categories.html" class="navbar-link">Categories</a><a href="career-path.html" class="navbar-link">Career Path</a><a href="skill-partners.html" class="navbar-link">Find Partners</a></div>
<div class="navbar-actions">@await Html.PartialAsync("_LearningChatNavigation")<div class="navbar-user" id="userMenu"><button class="navbar-avatar" id="avatarBtn"><span>@Model.Initials</span></button><div class="user-dropdown" id="userDropdown"><div class="dropdown-header"><div class="avatar avatar-md"><span>@Model.Initials</span></div><div><strong>@Model.FullName</strong><span>@Model.Email</span></div></div><div class="dropdown-divider"></div><a href="profile.html" class="dropdown-item">👤 My Profile</a><a href="my-skills.html" class="dropdown-item">🎯 My Skills</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="dropdown-item dropdown-logout" type="submit">🚪 Logout</button></form></div></div></div>
</div></nav>
<section class="dashboard-section"><div class="container">
<div class="welcome-header animate-fade-rise"><div><h1>Welcome back, <span class="text-primary">@firstName</span>! 👋</h1><p>Your dashboard shows only activity stored in your account.</p></div><a class="btn btn-primary btn-large" href="skill-partners.html">+ Find New Partners</a></div>
<div class="premium-banner"><div class="premium-banner-content"><span class="premium-banner-icon">⭐</span><div><strong>Learn with an approved expert</strong><p>Plus includes a limited allowance of focused expert sessions.</p></div></div><a href="pricing.html" class="btn btn-primary">View Plus →</a></div>
<div class="stats-grid stagger-children">
@foreach (var stat in new[] { ("🔄", Model.RequestsCount, "Learning Requests"), ("✓", Model.ActiveSessionsCount, "Active Sessions"), ("🎓", Model.LearnedSkillsCount, "Learning Interests"), ("👥", Model.ConnectionsCount, "Connections") }) {
<div class="stat-card"><div class="stat-icon stat-icon-primary">@stat.Item1</div><div class="stat-content"><span class="stat-value" data-count="@stat.Item2">0</span><span class="stat-label">@stat.Item3</span></div></div>}
</div>
<div class="dashboard-grid"><div class="dashboard-main">
<div class="dashboard-block">
    <div class="block-header"><h2>Upcoming Sessions</h2><a class="block-link" href="/chat.html">Messages</a><a class="block-link" href="/sessions.html">View Sessions →</a></div>
    <p>Active relationships: @Model.ActiveLearningRelationships · Pending session requests: @Model.PendingLearnerSessionRequests · Pending absence requests: @Model.PendingAbsences</p>
    @foreach (var request in Model.SchedulingRequests)
    {
        <div class="request-item"><a href="/sessions.html?requestId=@request.RelationshipId">@request.Skill · Awaiting Scheduling</a></div>
    }
    <p>Completed teaching: @Model.CompletedTeachingSessions · Completed learning: @Model.CompletedLearningSessions · Awaiting your review: @Model.AwaitingMyReviews</p>
    <p>Received reviews: @Model.ReceivedReviews · Rating: @(Model.TeacherAverageRating?.ToString("0.0") ?? "No reviews yet")</p>
    @if (Model.UpcomingSessions.Count == 0) { <p class="wf-muted">No upcoming sessions.</p> }
    @foreach (var session in Model.UpcomingSessions)
    {
        <div class="request-item"><a href="/session-details.html?id=@session.Id">@session.Title</a>
            <span>@session.Start.ToUniversalTime().ToString("yyyy-MM-dd HH:mm") UTC</span></div>
    }
</div>
<div class="dashboard-block animate-fade-rise-delay-1"><div class="block-header"><h2>Recent Requests</h2><a href="swap-requests.html" class="block-link">View All →</a></div><div class="requests-list">
@if (Model.IncomingPendingPeerRequests > 0) { <a class="block-link" href="/swap-requests.html?tab=incoming">Pending incoming requests (@Model.IncomingPendingPeerRequests)</a> }
@if (Model.RecentRequests.Count == 0) { <p class="wf-muted">No learning requests yet.</p> }
@foreach (var item in Model.RecentRequests) { <div class="request-item" data-request-id="@item.Id"><div class="request-avatar"><span>@item.PersonInitials</span></div><div class="request-info"><strong>@item.PersonName</strong><span class="request-skills">@item.SkillName</span></div><span class="badge badge-info">@item.Status</span></div> }
</div></div>
<div class="dashboard-block animate-fade-rise-delay-2"><div class="block-header"><h2>Recommended Partners</h2><a href="skill-partners.html" class="block-link">View All →</a></div><div class="recommended-grid">
@if (Model.RecommendedPartners.Count == 0) { <p class="wf-muted">No matching teachers are registered yet.</p> }
@foreach (var partner in Model.RecommendedPartners) { <div class="recommended-card"><div class="recommended-avatar"><span>@partner.Initials</span></div><h3>@partner.FullName</h3><p class="recommended-skill">@partner.SkillName</p>@if (partner.Rating.HasValue) { <div class="recommended-rating"><span class="rating-star">★</span><span>@partner.Rating.Value.ToString("0.0")</span></div> }<a class="btn btn-primary btn-sm" href="partner-profile.html?id=@partner.UserId">View Profile</a></div> }
</div></div></div>
<aside class="dashboard-side animate-slide-in-right"><div class="dashboard-block"><div class="block-header"><h2>My Skills</h2><a href="profile.html" class="block-link">View</a></div>
<div class="my-skills-section"><span class="skills-subtitle">Can Teach</span><div class="skill-tags">@if (Model.TeachSkills.Count == 0) { <span class="wf-muted">None selected</span> }@foreach (var skill in Model.TeachSkills) { <span class="skill-tag">@skill</span> }</div></div>
<div class="my-skills-section"><span class="skills-subtitle">Wants to Learn</span><div class="skill-tags">@if (Model.LearnSkills.Count == 0) { <span class="wf-muted">None selected</span> }@foreach (var skill in Model.LearnSkills) { <span class="skill-tag skill-tag-want">@skill</span> }</div></div>
</div></aside></div>
</div></section>
@await Html.PartialAsync("_Footer")
<script src="js/animations.js"></script><script src="js/dashboard.js" asp-append-version="true"></script><script src="js/name-outline.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script><script src="js/icon-tones.js"></script><script src="js/interface-polish.js"></script>
