@model ResetPasswordViewModel
@{
    ViewData["BodyClass"] = "compact-auth wf-page";
}

@section Head {<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Reset password - Skills Swap</title><link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/reset-password.css"><script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}

@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container"><div class="wf-header"><span class="wf-kicker">Skills Swap</span><h1>Reset password</h1><p>Choose a strong new password for your account.</p></div><section class="wf-card"><h2>Set a new password</h2><form method="post" asp-action="ResetPassword"><input type="hidden" asp-for="UserId"><input type="hidden" asp-for="Code"><div asp-validation-summary="ModelOnly" class="wf-errors" role="alert"></div><div class="form-group"><label class="form-label" asp-for="Password">New password</label><input class="form-input" asp-for="Password" required minlength="8" autocomplete="new-password"><span asp-validation-for="Password" class="text-danger"></span></div><div class="form-group"><label class="form-label" asp-for="ConfirmPassword">Confirm password</label><input class="form-input" asp-for="ConfirmPassword" required minlength="8" autocomplete="new-password"><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Reset password</button></form></section></div></main>

<script src="js/animations.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
<script src="js/icon-tones.js"></script>
<script src="js/interface-polish.js"></script>
