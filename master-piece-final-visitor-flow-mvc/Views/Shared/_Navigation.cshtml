@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    var navigationUser = User.Identity?.IsAuthenticated == true
        ? await UserManager.GetUserAsync(User)
        : null;
    var navigationInitials = NameFormatting.Initials(navigationUser?.FullName);
}
<nav class="navbar navbar-authed">
    <div class="navbar-container">
        
        <!-- الشعار -->
        <a href="home.html" class="navbar-logo"><span class="brand-symbol"><svg data-brand-mark viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10L3 14L7 18M3 14H15M17 6L21 10L17 14M21 10H9"/></g></svg></span><span class="brand-text"><span class="brand-wordmark" data-no-translate>Skills <span>Swap</span></span></span></a>

        <!-- روابط التنقل -->
        <div class="navbar-links">
            <a href="home.html" class="navbar-link">Home</a>
            <a href="categories.html" class="navbar-link active">Categories</a>
            <a href="career-path.html" class="navbar-link">Career Path</a>
            <a href="skill-partners.html" class="navbar-link">Find Partners</a>
        </div>

        <!-- الإجراءات: إشعارات + رسائل + Avatar -->
        <div class="navbar-actions">
            
            <!-- أيقونة الإشعارات -->
            

            @if (navigationUser is not null)
            {
                @await Html.PartialAsync("_LearningChatNavigation")
                <div class="navbar-user" id="userMenu">
                <button class="navbar-avatar" id="avatarBtn">
                    <span>@navigationInitials</span>
                </button>
                
                <!-- القائمة المنسدلة -->
                <div class="user-dropdown" id="userDropdown">
                    <div class="dropdown-header">
                        <div class="avatar avatar-md">
                            <span>@navigationInitials</span>
                        </div>
                        <div>
                            <strong>@navigationUser.FullName</strong>
                            <span>@navigationUser.Email</span>
                        </div>
                    </div>
                    
                    <div class="dropdown-divider"></div>
                    
                    <a href="profile.html" class="dropdown-item">
                        <span class="dropdown-icon">👤</span>
                        My Profile
                    </a>
                    <a href="dashboard.html" class="dropdown-item">
                        <span class="dropdown-icon">📊</span>
                        Dashboard
                    </a>
                    <a href="my-skills.html" class="dropdown-item">
                        <span class="dropdown-icon">🎯</span>
                        My Skills
                    </a>
                    <a href="swap-requests.html" class="dropdown-item">
                        <span class="dropdown-icon">🔄</span>
                        Swap Requests
                    </a>
                    
                    
                    <div class="dropdown-divider"></div>
                    
                    <button class="dropdown-item dropdown-logout" id="logoutBtn">
                        <span class="dropdown-icon">🚪</span>
                        Logout
                    </button>
                </div>
                </div>
            }
            else
            {
                <a href="/login.html" class="btn btn-outline">Login</a>
                <a href="/signup.html" class="btn btn-primary">Sign Up</a>
            }

        </div>
    </div>
</nav>
