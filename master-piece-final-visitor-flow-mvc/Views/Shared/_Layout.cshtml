<!DOCTYPE html>
<html lang="en">
<head>
    @await RenderSectionAsync("Head")
    @if (User.IsInRole("Admin"))
    {
        <script src="/js/site-preferences-init.js"></script>
        <link rel="stylesheet" href="/css/site-preferences.css">
        <link rel="stylesheet" href="/css/interface-polish.css">
        <link rel="stylesheet" href="/Admin/admin-css/admin-cycle-polish.css">
        <style>.admin-account-link{display:flex!important;flex-direction:column;align-items:flex-start!important;gap:2px}.admin-account-email{display:block;max-width:100%;overflow:hidden;text-overflow:ellipsis;color:#c7b9e3;font-size:10px;font-weight:400}.admin-sidebar-footer~.admin-sidebar-footer{display:none!important}</style>
    }
</head>
<body class="@ViewData["BodyClass"]">
    @RenderBody()
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="siteLogoutForm" method="post" action="/account/logout" hidden>
            @Html.AntiForgeryToken()
        </form>
    }
    @if (User.IsInRole("Admin"))
    {
        <script src="/js/site-ar.js"></script>
        <script src="/js/site-preferences.js"></script>
        <script src="/js/interface-polish.js"></script>
    }
    @if (Context.Items.ContainsKey("LearningChatNavigation"))
    {
        <script src="/js/chat-unread.js" asp-append-version="true" defer></script>
    }
</body>
</html>
