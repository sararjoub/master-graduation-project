@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container"><div class="wf-header"><span class="wf-kicker">Skills Swap</span><h1>Help &amp; FAQs</h1><p>Answers about learning, booking, and your account.</p></div><div class="wf-grid"><section class="wf-card"><h2>Frequently asked questions</h2><h3>Do I have to teach?</h3><p>No. Look for volunteer teachers or use free introductory resources.</p><h3>What does the learning guide do?</h3><p>It suggests a skill order from administrator-curated sequences. You choose your next step; it never approves experts or books meetings.</p><h3>Are expert sessions unlimited?</h3><p>No. Plus has a defined monthly allowance.</p></section></div><div class="wf-note wf-muted" role="note">Frontend preview: sample data only. Actions update this page for review; no email, payment, AI service, or database is connected. Nothing is stored in the browser.</div></div></main>
@await Html.PartialAsync("_Footer2")
