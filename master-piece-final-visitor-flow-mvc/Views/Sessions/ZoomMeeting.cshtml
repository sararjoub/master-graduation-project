@model VideoMeetingPage
@{ ViewData["BodyClass"] = "wf-page"; }
@section Head {
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Meeting - Skills Swap</title>
    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/site-preferences.css">
    <link rel="stylesheet" href="/css/responsive-refinements.css">
    <link rel="stylesheet" href="/css/brand.css">
    <link rel="stylesheet" href="/css/interface-polish.css">
    <link rel="stylesheet" href="/css/workflow-ui.css">
    <link rel="stylesheet" href="/css/learning-communication.css" asp-append-version="true">
    <script src="/js/site-preferences-init.js"></script>
}
@await Html.PartialAsync("_Navigation")
<main class="wf-section">
    <div class="wf-container">
        <div class="wf-header"><h1>Video Meeting</h1></div>
        <section class="wf-card">
            <h2>@Model.Title</h2>
            <p>@Model.Skill · @Model.StartsAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC · @Model.Duration min</p>
            <p>Teacher: @Model.Teacher · Learner: @Model.Learner</p>
            <p id="meetingStatus" role="status">@Model.Availability</p>
            @if (Model.Room is not null)
            {
                <p>Jitsi may ask the host to sign in separately. If prompted to wait for a moderator, keep this page open while the host signs in. Anyone with the external room details may be able to reach the room outside Skills Swap.</p>
                <div id="learningMeeting" data-room="@Model.Room" data-domain="@Model.Domain"
                     data-display-name="@Model.DisplayName"></div>
                <button type="button" id="retryMeeting" class="btn btn-outline" hidden>Retry meeting connection</button>
                <script src="/js/video-meeting.js" asp-append-version="true" defer></script>
            }
            else if (Model.Availability == "Meeting is available.")
            {
                <p>Open the meeting from Session Details to initialize this room.</p>
            }
            <a class="btn btn-outline" href="/session-details.html?id=@Model.Id">Return to Session Details</a>
        </section>
    </div>
</main>
@await Html.PartialAsync("_Footer2")
<script src="/js/animations.js"></script>
<script src="/js/site-preferences.js"></script>
<script src="/js/icon-tones.js"></script>
<script src="/js/interface-polish.js"></script>
