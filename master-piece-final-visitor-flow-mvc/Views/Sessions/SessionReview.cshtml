@{
    ViewData["BodyClass"] = "wf-page";
}

@section Head {<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Review a completed experience - Skills Swap</title><link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/session-review.css"><script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}

@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container"><div class="wf-header"><span class="wf-kicker">Skills Swap</span><h1>Review a completed experience</h1><p>Reviews are eligible only after confirmed completion.</p></div><section class="wf-card"><h2>Completed sample session</h2><form data-wf-form="experience-review"><div class="wf-errors" role="alert"></div><div class="form-group"><label class="form-label" for="rating">Rating</label><select class="form-input" id="rating" name="rating"><option value="5">5 · Excellent</option><option value="4">4 · Good</option><option value="3">3 · Average</option><option value="2">2 · Below expectations</option><option value="1">1 · Poor</option></select></div><div class="form-group"><label class="form-label" for="comment">Your feedback</label><textarea class="form-textarea" rows="4" id="comment" name="comment" required minlength="10" maxlength="1000"></textarea></div><button class="btn btn-primary" type="submit">Preview review</button><p class="wf-feedback" role="status" aria-live="polite"></p></form><div class="wf-note " role="note">One eligible review per participant per experience. The backend must verify completion and prevent duplicate submissions.</div></section><div class="wf-note wf-muted" role="note">Frontend preview: sample data only. Actions update this page for review; no email, payment, AI service, or database is connected. Nothing is stored in the browser.</div></div></main>
@await Html.PartialAsync("_Footer2")
<script src="js/animations.js"></script><script src="js/workflow-ui.js"></script><script src="js/session-review.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
<script src="js/icon-tones.js"></script>
<script src="js/interface-polish.js"></script>
