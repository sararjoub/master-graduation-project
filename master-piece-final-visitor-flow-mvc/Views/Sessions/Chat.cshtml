@model LearningChatPage
@{
    var selected = Model.Conversations.SingleOrDefault(c => c.Id == Model.SelectedId);
}
@section Head {
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages - Skills Swap</title>
    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/chat.css">
    <link rel="stylesheet" href="/css/site-preferences.css">
    <link rel="stylesheet" href="/css/responsive-refinements.css">
    <link rel="stylesheet" href="/css/brand.css">
    <link rel="stylesheet" href="/css/interface-polish.css">
    <link rel="stylesheet" href="/css/learning-communication.css" asp-append-version="true">
    <script src="/js/site-preferences-init.js"></script>
}
@await Html.PartialAsync("_Navigation")
<section class="chat-section">
    <div class="chat-container">
        <aside class="chat-sidebar animate-slide-in-left">
            <div class="chat-sidebar-header"><h2>Messages</h2></div>
            <div class="conversations-list">
                @foreach (var conversation in Model.Conversations)
                {
                    <a class="conversation-item @(conversation.Id == Model.SelectedId ? "active" : "")"
                       href="/chat.html?requestId=@conversation.Id" data-conversation="@conversation.Id">
                        <div class="conversation-avatar">
                            @if (!string.IsNullOrWhiteSpace(conversation.ProfileImage))
                            {
                                <img src="@conversation.ProfileImage" alt="" loading="lazy" referrerpolicy="no-referrer">
                            }
                            else { <span>@char.ToUpperInvariant(conversation.Partner.FirstOrDefault(' '))</span> }
                        </div>
                        <div class="conversation-info">
                            <div class="conversation-top"><strong>@conversation.Partner</strong></div>
                            <small>@conversation.Skill</small>
                            <div class="conversation-bottom">
                                <span class="conversation-preview">@(conversation.LastBody ?? "No messages yet")</span>
                                <span class="unread-badge" hidden="@(conversation.Unread == 0)">@conversation.Unread</span>
                            </div>
                            @if (conversation.LastAt is DateTime last)
                            {
                                <time class="conversation-time">@last.ToString("yyyy-MM-dd HH:mm") UTC</time>
                            }
                        </div>
                    </a>
                }
                @if (Model.Conversations.Count == 0)
                {
                    <p class="learning-chat-note">Conversations appear after a learning request is accepted.
                        <a href="/swap-requests.html">View learning requests</a>
                    </p>
                }
            </div>
        </aside>
        <main class="chat-main" id="learningChat" data-request="@Model.SelectedId">
            @if (selected is null)
            {
                <p class="learning-chat-note">Select a conversation to view its messages.</p>
            }
            else
            {
                <div class="chat-header">
                    <div><strong>@selected.Partner</strong><div>@selected.Skill</div></div>
                    <a href="/sessions.html?requestId=@selected.Id">Relationship Sessions</a>
                </div>
                <p class="learning-chat-note" id="chatStatus" role="status">Loading messages…</p>
                <button type="button" class="btn btn-outline" id="chatOlder" hidden>Load earlier messages</button>
                <div class="chat-messages" id="chatMessages"></div>
                <form class="chat-input-wrapper" id="chatCompose">
                    @Html.AntiForgeryToken()
                    <label for="messageInput" class="learning-chat-label">Message</label>
                    <input id="messageInput" name="body" class="chat-input" maxlength="4000" required
                           placeholder="Type a message…" disabled="@(!Model.CanSend)">
                    <button type="submit" class="chat-send-btn" disabled="@(!Model.CanSend)">Send</button>
                </form>
            }
        </main>
    </div>
</section>
@await Html.PartialAsync("_Footer2")
<script src="/js/animations.js"></script>
<script src="/js/chat.js" asp-append-version="true" defer></script>
<script src="/js/site-preferences.js"></script>
<script src="/js/icon-tones.js"></script>
<script src="/js/interface-polish.js"></script>
