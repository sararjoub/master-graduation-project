@model AdminPaymentsViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Transactions - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-transactions.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="admin-page-header"><div><h1>Transactions</h1><p>Read-only payment audit records from the database.</p></div></div><div class="admin-stats-grid"><div class="admin-stat-card"><strong>@Model.PaidCount</strong><span>Paid transactions</span></div><div class="admin-stat-card"><strong>@Model.FailedCount</strong><span>Failed transactions</span></div><div class="admin-stat-card"><strong>$@Model.PaidTotal.ToString("0.00")</strong><span>Paid revenue</span></div></div><div class="admin-card"><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Reference</th><th>Member</th><th>Plan</th><th>Provider</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead><tbody>@foreach(var item in Model.Payments){<tr><td>@item.Reference</td><td>@item.UserName<br><small>@item.Email</small></td><td>@item.Plan</td><td>@item.Provider</td><td>@item.Amount.ToString("0.00") @item.Currency</td><td>@item.Status</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td></tr>}</tbody></table></div>@if(Model.Payments.Count==0){<div class="admin-card-body">No payment transactions have been recorded yet.</div>}</div></div></main></div><script src="../admin-js/admin-shared.js"></script>
