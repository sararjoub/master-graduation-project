@model AdminUserDetailsViewModel
@functions { string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0]))); }
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Member Details - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-user-details.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar" id="adminSidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="user-details-header"><div class="user-details-header-info"><div class="user-details-avatar">@Initials(Model.FullName)</div><div><h1>@Model.FullName</h1><p>@Model.Email</p><span class="admin-badge @(Model.Status==AccountStatus.Active?"admin-badge-success":"admin-badge-danger")">@Model.Status</span> <span class="admin-badge @(Model.EmailConfirmed?"admin-badge-success":"admin-badge-warning")">Email @(Model.EmailConfirmed?"verified":"unverified")</span></div></div><div class="user-details-header-actions"><a class="admin-btn admin-btn-outline" href="edit-user.html?id=@Model.Id">Edit Account Status</a></div></div>
@if(TempData["AdminMessage"] is string msg){<div class="admin-alert admin-alert-success">@msg</div>}
<div class="user-stats-grid"><div class="user-stat-card"><div class="user-stat-icon user-stat-icon-success">✅</div><div class="user-stat-value">@Model.CompletedSessions</div><div class="user-stat-label">Completed Sessions</div></div><div class="user-stat-card"><div class="user-stat-icon user-stat-icon-warning">⏳</div><div class="user-stat-value">@Model.PendingRequests</div><div class="user-stat-label">Pending Requests</div></div><div class="user-stat-card"><div class="user-stat-icon user-stat-icon-info">⭐</div><div class="user-stat-value">@Model.Reviews</div><div class="user-stat-label">Reviews</div></div><div class="user-stat-card"><div class="user-stat-icon user-stat-icon-primary">★</div><div class="user-stat-value">@(Model.Rating?.ToString("0.0") ?? "—")</div><div class="user-stat-label">Average Rating</div></div></div>
<div class="user-details-grid"><div class="user-details-main"><div class="admin-card"><div class="admin-card-header"><h3 class="admin-card-title">Skills</h3></div><div class="admin-card-body"><div class="user-skills-block"><h4 class="user-skills-title">🎓 Can Teach</h4><div class="user-skills-tags">@if(Model.TeachSkills.Count==0){<span>No teaching skills selected.</span>}@foreach(var skill in Model.TeachSkills){<span class="user-skill-tag">@skill</span>}</div></div><div class="user-skills-block"><h4 class="user-skills-title">📚 Wants to Learn</h4><div class="user-skills-tags">@if(Model.LearnSkills.Count==0){<span>No learning skills selected.</span>}@foreach(var skill in Model.LearnSkills){<span class="user-skill-tag user-skill-tag-want">@skill</span>}</div></div><div class="user-skills-block"><h4 class="user-skills-title">★ Approved Expert Skills</h4><div class="user-skills-tags">@if(Model.ExpertSkills.Count==0){<span>Not an approved expert.</span>}@foreach(var skill in Model.ExpertSkills){<span class="user-skill-tag">@skill</span>}</div></div></div></div></div><aside class="user-details-side"><div class="admin-card"><div class="admin-card-header"><h3 class="admin-card-title">Profile Information</h3></div><div class="admin-card-body"><p><strong>Location:</strong> @(Model.Location ?? "Not provided")</p><p><strong>Profile:</strong> @(Model.IsProfileComplete?"Complete":"Incomplete")</p><p><strong>Joined:</strong> @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</p><p><strong>Bio:</strong> @(Model.Bio ?? "Not provided")</p></div></div></aside></div></div></main></div><script src="../admin-js/admin-shared.js"></script>
