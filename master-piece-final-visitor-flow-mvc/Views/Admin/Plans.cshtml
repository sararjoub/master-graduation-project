@model AdminPlansViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Plans - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-plans.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="admin-page-header"><div><h1>Free & Plus Plans</h1><p>Manage prices and expert-session credits without changing stable plan codes.</p></div></div>@if(TempData["AdminMessage"] is string msg){<div class="admin-alert admin-alert-success">@msg</div>}<div class="plans-grid">@foreach(var plan in Model.Plans){<article class="admin-card"><div class="admin-card-header"><div><h2>@plan.Name</h2><span class="admin-badge">@plan.Code</span></div></div><div class="admin-card-body"><p><strong>@plan.Subscribers</strong> active subscribers</p>@if (plan.Code == SubscriptionTerms.Plus) { <form method="post" action="/Admin/plans/save">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@plan.Id"><div class="form-group"><label>Name</label><input class="form-input" name="Name" value="@plan.Name" required></div><div class="form-group"><label>Monthly price</label><input class="form-input" name="MonthlyPrice" value="@plan.MonthlyPrice" type="number" min="0" step="0.01"></div><div class="form-group"><label>Yearly price</label><input class="form-input" name="YearlyPrice" value="@plan.YearlyPrice" type="number" min="0" step="0.01"></div><div class="form-group"><label>Monthly expert credits</label><input class="form-input" name="MonthlyExpertCredits" value="@plan.MonthlyExpertCredits" type="number" min="0"></div><div class="form-group"><label for="expert-price">Additional expert session price (USD)</label><input class="form-input" id="expert-price" name="AdditionalExpertPrice" value="@plan.AdditionalExpertPrice" type="number" min="0.01" step="0.01" required></div>
<div class="form-group"><label for="expert-duration">Expert session duration (minutes)</label><input class="form-input" id="expert-duration" name="ExpertSessionMinutes" value="@plan.ExpertSessionMinutes" type="number" min="1" max="180" required></div>
<div class="form-group"><label for="expert-share">Expert share (%)</label><input class="form-input" id="expert-share" name="ExpertSharePercent" value="@plan.ExpertSharePercent" type="number" min="0" max="100" step="0.01" required></div>
<div class="form-group"><label for="platform-share">Platform share (%)</label><input class="form-input" id="platform-share" name="PlatformSharePercent" value="@(100 - plan.ExpertSharePercent)" type="number" min="0" max="100" step="0.01" required></div>
<label><input type="checkbox" name="IsActive" value="true" checked="@plan.IsActive"> Active</label><button class="admin-btn admin-btn-primary" type="submit">Save Plan</button></form> } else { <p>Free membership</p> }</div></article>}</div></div></main></div><script src="../admin-js/admin-shared.js"></script>
