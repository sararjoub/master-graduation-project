@model AdminReviewsViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Reviews - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-reviews.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="admin-page-header"><div><h1>Reviews</h1><p>Platform feedback from completed sessions. Private messages and meetings are never displayed.</p></div></div><div class="admin-stats-grid"><div class="admin-stat-card"><strong>@Model.Total</strong><span>Total Reviews</span></div><div class="admin-stat-card"><strong>@Model.Positive</strong><span>Positive (4–5)</span></div><div class="admin-stat-card"><strong>@Model.Neutral</strong><span>Neutral (3)</span></div><div class="admin-stat-card"><strong>@Model.Critical</strong><span>Critical (1–2)</span></div><div class="admin-stat-card"><strong>@(Model.Average?.ToString("0.0")??"—")</strong><span>Average Rating</span></div></div><div class="admin-card"><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Reviewer</th><th>Reviewed member</th><th>Skill</th><th>Rating</th><th>Comment</th><th>Date</th></tr></thead><tbody>@foreach(var item in Model.Reviews){<tr><td>@item.Reviewer</td><td>@item.ReviewedUser</td><td>@item.Skill</td><td>@item.Rating / 5</td><td>@(string.IsNullOrWhiteSpace(item.Comment)?"No comment":item.Comment)</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td></tr>}</tbody></table></div>@if(Model.Reviews.Count==0){<div class="admin-card-body">No reviews have been submitted yet.</div>}</div></div></main></div><script src="../admin-js/admin-shared.js"></script>
