@model AdminDashboardViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard - Skills Swap</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-dashbord.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar" id="adminSidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="admin-page-header"><div class="admin-page-header-left"><h1>Platform Dashboard</h1><p>Live operational overview for Skills Swap.</p></div></div>
<div class="admin-stats-grid"><div class="admin-stat-card"><div class="admin-stat-info"><div class="admin-stat-value">@Model.Members</div><div class="admin-stat-label">Members</div></div></div><div class="admin-stat-card"><div class="admin-stat-info"><div class="admin-stat-value">@Model.ActiveSkills</div><div class="admin-stat-label">Active Skills</div></div></div><div class="admin-stat-card"><div class="admin-stat-info"><div class="admin-stat-value">@Model.ApprovedExperts</div><div class="admin-stat-label">Approved Experts</div></div></div><div class="admin-stat-card"><div class="admin-stat-info"><div class="admin-stat-value">@Model.ActiveSubscriptions</div><div class="admin-stat-label">Active Plus</div></div></div><div class="admin-stat-card"><div class="admin-stat-info"><div class="admin-stat-value">@Model.ScheduledSessions</div><div class="admin-stat-label">Scheduled Sessions</div></div></div><div class="admin-stat-card"><div class="admin-stat-info"><div class="admin-stat-value">$@Model.PaidRevenue.ToString("0.00")</div><div class="admin-stat-label">Paid Revenue</div></div></div></div>
<div class="admin-card"><div class="admin-card-header"><div><h3 class="admin-card-title">Needs Attention</h3><p class="admin-card-subtitle">Items that may require an administrator decision.</p></div></div><div class="admin-card-body"><div class="admin-stats-grid"><a class="admin-stat-card" href="expert-applications.html?status=UnderReview"><strong>@Model.PendingExpertApplications</strong><span>Expert applications to review</span></a><a class="admin-stat-card" href="manage-users.html?filter=unverified"><strong>@Model.UnverifiedMembers</strong><span>Unverified member emails</span></a><a class="admin-stat-card" href="manage-users.html"><strong>@Model.IncompleteProfiles</strong><span>Incomplete profiles</span></a><div class="admin-stat-card"><strong>@Model.CareerPathsAwaitingReview</strong><span>AI career paths awaiting review</span></div><a class="admin-stat-card" href="manage-subscriptions.html"><strong>@Model.SubscriptionsExpiringSoon</strong><span>Plus plans expiring in 7 days</span></a></div></div></div>
<div class="admin-dashboard-grid"><div class="admin-card"><div class="admin-card-header"><h3 class="admin-card-title">Newest Members</h3><a href="manage-users.html">View all</a></div><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Name</th><th>Email</th><th>Verified</th><th>Joined</th><th></th></tr></thead><tbody>@foreach(var user in Model.RecentMembers){<tr><td>@(string.IsNullOrWhiteSpace(user.Name)?"Incomplete profile":user.Name)</td><td>@user.Email</td><td>@(user.Verified?"Yes":"No")</td><td>@user.Joined.ToLocalTime().ToString("dd MMM yyyy")</td><td><a href="user-details.html?id=@user.Id">View</a></td></tr>}</tbody></table></div></div><div class="admin-card"><div class="admin-card-header"><h3 class="admin-card-title">Recent Expert Applications</h3><a href="expert-applications.html">Review all</a></div><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Member</th><th>Skill</th><th>Status</th><th>Submitted</th></tr></thead><tbody>@foreach(var item in Model.RecentExpertApplications){<tr><td>@item.Member</td><td>@item.Skill</td><td><span class="admin-badge">@item.Status</span></td><td>@item.Submitted.ToLocalTime().ToString("dd MMM")</td></tr>}</tbody></table></div></div></div></div></main></div><script src="../admin-js/admin-shared.js"></script>
