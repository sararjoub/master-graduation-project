@model AdminExpertApplicationsViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Expert Applications - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-expert-applications.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar" id="adminSidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="wf-admin-content"><div class="wf-header"><span class="wf-kicker">Admin Panel</span><h1>Expert applications</h1><p>Approval applies only to the requested skill and every decision is documented.</p></div>
@if(TempData["AdminMessage"] is string msg){<div class="wf-note">@msg</div>}@if(TempData["AdminError"] is string err){<div class="wf-errors">@err</div>}
<div class="users-stats-grid"><div class="users-stat-card"><strong>@Model.UnderReviewCount</strong><span>Under review</span></div><div class="users-stat-card"><strong>@Model.NeedsInformationCount</strong><span>Needs information</span></div><div class="users-stat-card"><strong>@Model.ApprovedCount</strong><span>Approved</span></div><div class="users-stat-card"><strong>@Model.RejectedCount</strong><span>Rejected</span></div></div>
<form method="get" class="users-filter-group"><button name="status" value="all">All</button>@foreach(var status in Enum.GetValues<ExpertApplicationStatus>()){<button name="status" value="@status">@status</button>}</form>
@if(Model.Applications.Count==0){<section class="wf-card"><h2>No applications found</h2><p>New applications will appear here after members submit them.</p></section>}
@foreach(var item in Model.Applications){<div class="wf-grid"><section class="wf-card"><h2>@item.UserName</h2><h3>@item.SkillName</h3><span class="wf-badge">@item.Status</span><p><strong>Email:</strong> @item.Email</p><p><strong>Experience:</strong> @item.Experience</p><p><strong>Teaching approach:</strong> @item.TeachingApproach</p><p><strong>Submitted:</strong> @item.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>@if(!string.IsNullOrWhiteSpace(item.PortfolioUrl)){<p><a href="@item.PortfolioUrl" target="_blank" rel="noopener">Open portfolio</a></p>}@if(!string.IsNullOrWhiteSpace(item.SampleUrl)){<p><a href="@item.SampleUrl" target="_blank" rel="noopener">Open teaching sample</a></p>}@if(!string.IsNullOrWhiteSpace(item.AdminReason)){<div class="wf-note"><strong>Last decision:</strong> @item.AdminReason</div>}</section><section class="wf-card"><h2>Review decision</h2><form method="post" action="/Admin/expert-applications/decision">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@item.Id"><div class="form-group"><label class="form-label">Decision</label><select class="form-input" name="Decision"><option value="Approved">Approve this skill</option><option value="NeedsInformation">Request more information</option><option value="Rejected">Reject application</option></select></div><div class="form-group"><label class="form-label">Reason and feedback</label><textarea class="form-textarea" name="Reason" required minlength="10" maxlength="1500" rows="4"></textarea></div><button class="btn btn-primary" type="submit">Save decision</button></form></section></div>}</div></main></div><script src="../admin-js/admin-shared.js"></script>
