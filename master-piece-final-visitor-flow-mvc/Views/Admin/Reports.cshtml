@model AdminAnalyticsViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Analytics - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-reports.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="admin-page-header"><div><h1>Reports & Analytics</h1><p>Real platform performance without invented trends or demo values.</p></div></div><div class="admin-stats-grid"><div class="admin-stat-card"><strong>@Model.Members</strong><span>Accounts</span></div><div class="admin-stat-card"><strong>@Model.Sessions</strong><span>Learning Sessions</span></div><div class="admin-stat-card"><strong>@Model.CompletedSessions</strong><span>Completed Sessions</span></div><div class="admin-stat-card"><strong>@Model.Reviews</strong><span>Reviews</span></div><div class="admin-stat-card"><strong>@(Model.AverageRating?.ToString("0.0")??"—")</strong><span>Average Rating</span></div><div class="admin-stat-card"><strong>@Model.CareerPaths</strong><span>Career Paths</span></div><div class="admin-stat-card"><strong>@Model.ActivePlus</strong><span>Active Plus</span></div><div class="admin-stat-card"><strong>$@Model.Revenue.ToString("0.00")</strong><span>Paid Revenue</span></div></div><div class="admin-card"><div class="admin-card-header"><div><h3 class="admin-card-title">Skill Demand</h3><p class="admin-card-subtitle">Compare learners, volunteer teachers and learning requests.</p></div></div><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Skill</th><th>Learners</th><th>Teachers</th><th>Requests</th><th>Supply indicator</th></tr></thead><tbody>@foreach(var item in Model.PopularSkills){<tr><td>@item.Skill</td><td>@item.Learners</td><td>@item.Teachers</td><td>@item.Requests</td><td>@(item.Teachers==0&&item.Learners>0?"Needs teachers":item.Teachers<item.Learners?"Demand exceeds supply":"Covered")</td></tr>}</tbody></table></div></div></div></main></div><script src="../admin-js/admin-shared.js"></script>
