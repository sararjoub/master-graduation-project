@model AdminUsersViewModel
@functions { string Q(int page) => $"?search={Uri.EscapeDataString(Model.Search)}&filter={Model.Filter}&page={page}"; string Initials(string name) => string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>char.ToUpperInvariant(x[0]))); }
@section Head {<meta name="viewport" content="width=device-width, initial-scale=1"><title>Manage Users | Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-mange-users.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div><aside class="admin-sidebar" id="adminSidebar"><button class="admin-sidebar-dismiss" type="button" data-admin-close>×</button><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")<div class="admin-sidebar-footer"><a class="admin-sidebar-link" href="admin-profile.html">Admin account</a><button class="admin-sidebar-logout" id="adminLogout" type="button">Log out</button></div></aside>
<main class="admin-main"><button type="button" class="admin-mobile-menu" id="adminSidebarToggle">☰</button><div class="admin-content manage-users-page"><section class="users-page-heading"><div><h2>Platform Members</h2><p>Review registered users, verification, profile completion and account access.</p></div></section>
<section class="users-stats-grid"><div class="users-stat-card"><span class="users-stat-icon purple">👥</span><div><span class="users-stat-label">Total Users</span><strong>@Model.TotalUsers</strong></div></div><div class="users-stat-card"><span class="users-stat-icon green">✓</span><div><span class="users-stat-label">Verified Emails</span><strong>@Model.VerifiedUsers</strong></div></div><div class="users-stat-card"><span class="users-stat-icon red">⊘</span><div><span class="users-stat-label">Suspended Accounts</span><strong>@Model.SuspendedUsers</strong></div></div><div class="users-stat-card"><span class="users-stat-icon gold">★</span><div><span class="users-stat-label">Verified Experts</span><strong>@Model.ExpertUsers</strong></div></div></section>
<section class="users-directory"><div class="users-directory-heading"><div><h3>Users Directory</h3><p>All values below come from the database.</p></div></div><form method="get" class="users-toolbar"><div class="users-search-field"><span>⌕</span><input type="search" name="search" value="@Model.Search" placeholder="Search by name or email..."></div><div class="users-filter-group">@foreach(var item in new[]{("all","All Users"),("active","Active"),("suspended","Suspended"),("unverified","Unverified"),("experts","Experts")}){<button name="filter" value="@item.Item1" class="users-filter @(Model.Filter==item.Item1?"active":"")">@item.Item2</button>}</div></form>
<div class="users-table-scroll"><table class="users-table"><thead><tr><th>User</th><th>Role</th><th>Email Verification</th><th>Account Status</th><th>Joined</th><th>Actions</th></tr></thead><tbody>@foreach(var user in Model.Users){<tr><td><div class="admin-table-user"><div class="admin-table-avatar">@Initials(user.FullName)</div><div class="admin-table-user-info"><div class="admin-table-user-name">@(string.IsNullOrWhiteSpace(user.FullName)?"Profile not completed":user.FullName)</div><div class="admin-table-user-email">@user.Email</div></div></div></td><td>@(user.IsExpert?"Expert · Member":"Member")</td><td><span class="admin-badge @(user.EmailConfirmed?"admin-badge-success":"admin-badge-warning")">@(user.EmailConfirmed?"Verified":"Unverified")</span></td><td><span class="admin-badge @(user.Status==AccountStatus.Active?"admin-badge-success":"admin-badge-danger")">@user.Status</span></td><td>@user.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td><td><div class="admin-table-actions"><a class="admin-btn admin-btn-outline" href="user-details.html?id=@user.Id">View</a><a class="admin-btn admin-btn-primary" href="edit-user.html?id=@user.Id">Edit</a></div></td></tr>}</tbody></table></div>@if(Model.Users.Count==0){<div class="users-empty-state"><h3>No users found</h3><p>Try another search or filter.</p></div>}<div class="users-table-footer"><span>Showing @Model.Users.Count users</span><div class="users-pagination"><a href="@(Model.Page<=1?"#":Q(Model.Page-1))">←</a><span>Page @Model.Page of @Model.PageCount</span><a href="@(Model.Page>=Model.PageCount?"#":Q(Model.Page+1))">→</a></div></div></section></div></main></div><script src="../admin-js/admin-shared.js"></script>
