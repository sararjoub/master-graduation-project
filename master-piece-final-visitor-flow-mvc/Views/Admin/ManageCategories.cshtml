@model ManageCategoriesViewModel
@functions { private static string Icon(string slug) => slug switch { "technology" => "💻", "education" => "🎓", "handmade" => "🎨", "entertainment" => "🎬", "business" => "💼", "health-fitness" => "❤️", _ => "📁" }; }
@section Head {
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Manage Categories - Skills Swap Admin</title>
<link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-categories.css"><script src="../../js/site-preferences-init.js"></script><link rel="stylesheet" href="../../css/site-preferences.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css"><link rel="icon" type="image/svg+xml" href="../../assests/brand-mark.svg"><link rel="stylesheet" href="../../css/interface-polish.css">
}
<div class="admin-layout"><div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div>
<aside class="admin-sidebar" id="adminSidebar"><button class="admin-sidebar-dismiss" type="button" data-admin-close aria-label="Close sidebar">×</button><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol"><svg data-brand-mark viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10L3 14L7 18M3 14H15M17 6L21 10L17 14M21 10H9"/></g></svg></span><span class="brand-text"><span class="brand-wordmark" data-no-translate>Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")<div class="admin-sidebar-footer"><a class="admin-sidebar-link" href="admin-profile.html">Admin account</a><button class="admin-sidebar-logout" id="adminLogout" type="button">Log out</button></div></aside>
<main class="admin-main"><button type="button" class="admin-mobile-menu" id="adminSidebarToggle" aria-label="Open sidebar" aria-controls="adminSidebar" aria-expanded="false">☰</button><div class="admin-content manage-categories-page">
<div class="admin-page-header admin-fade-rise"><div class="admin-page-header-left"><h1>Manage Categories</h1><p>Organize the platform catalogue and its subcategories.</p></div><div class="admin-page-header-actions"><button type="button" class="admin-btn admin-btn-primary" data-open-modal="category-create-modal">+ Add New Category</button></div></div>
@if (TempData["AdminMessage"] is string message) { <div class="categories-note" role="status">@message</div> }
<div asp-validation-summary="All" class="wf-errors" role="alert"></div>

<div class="admin-stats-grid admin-stagger"><div class="admin-stat-card"><div class="admin-stat-header"><div class="admin-stat-icon admin-stat-icon-primary">📁</div></div><div class="admin-stat-info"><div class="admin-stat-value">@Model.Categories.Count</div><div class="admin-stat-label">Total Categories</div></div></div><div class="admin-stat-card"><div class="admin-stat-header"><div class="admin-stat-icon admin-stat-icon-success">✅</div></div><div class="admin-stat-info"><div class="admin-stat-value">@Model.ActiveCategories</div><div class="admin-stat-label">Active Categories</div></div></div><div class="admin-stat-card"><div class="admin-stat-header"><div class="admin-stat-icon admin-stat-icon-info">🗂️</div></div><div class="admin-stat-info"><div class="admin-stat-value">@Model.TotalSubCategories</div><div class="admin-stat-label">Subcategories</div></div></div><div class="admin-stat-card"><div class="admin-stat-header"><div class="admin-stat-icon admin-stat-icon-warning">🎯</div></div><div class="admin-stat-info"><div class="admin-stat-value">@Model.TotalSkills</div><div class="admin-stat-label">Skills</div></div></div></div>

<div class="categories-grid admin-stagger">@foreach (var category in Model.Categories) { <article class="category-card"><div class="category-card-header"><div class="category-card-icon">@Icon(category.Slug)</div><div class="category-card-actions"><button type="button" data-open-modal="category-details-@category.Id" aria-label="View @category.NameEn">👁️</button><button type="button" data-open-modal="category-edit-@category.Id" aria-label="Edit @category.NameEn">✏️</button></div></div><h2 class="category-card-title">@category.NameEn</h2><p class="category-card-desc">@(string.IsNullOrWhiteSpace(category.Description) ? "No description added yet." : category.Description)</p><div class="category-card-footer"><small>@category.SubCategories.Count subcategories · @category.SubCategories.Sum(x => x.SkillCount) skills</small><span class="admin-badge @(category.IsActive ? "admin-badge-success" : "admin-badge-warning")">@(category.IsActive ? "Active" : "Inactive")</span></div><button class="category-card-subaction" type="button" data-open-modal="category-details-@category.Id">View &amp; manage subcategories</button></article> }</div>
</div></main></div>

<div class="modal-overlay hidden" id="category-create-modal"><div class="modal" role="dialog" aria-modal="true"><div class="modal-header"><h2>Add Category</h2><button type="button" class="modal-close" data-close-modal>✕</button></div><form method="post" action="/Admin/categories/save">@Html.AntiForgeryToken()<div class="modal-body"><div class="form-group"><label class="form-label">Category name</label><input class="form-input" name="NameEn" required maxlength="80"></div><div class="form-group"><label class="form-label">Slug</label><input class="form-input" name="Slug" placeholder="category-name" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></div><div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="Description" maxlength="500" rows="3"></textarea></div></div><div class="modal-footer"><button type="button" class="admin-btn admin-btn-outline" data-close-modal>Cancel</button><button class="admin-btn admin-btn-primary" type="submit">Save Category</button></div></form></div></div>

@foreach (var category in Model.Categories) {
<div class="modal-overlay hidden" id="category-edit-@category.Id"><div class="modal" role="dialog" aria-modal="true"><div class="modal-header"><h2>Edit @category.NameEn</h2><button type="button" class="modal-close" data-close-modal>✕</button></div><form method="post" action="/Admin/categories/save">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@category.Id"><div class="modal-body"><div class="form-group"><label class="form-label">Category name</label><input class="form-input" name="NameEn" value="@category.NameEn" required maxlength="80"></div><div class="form-group"><label class="form-label">Slug</label><input class="form-input" name="Slug" value="@category.Slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></div><div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" name="Description" maxlength="500" rows="3">@category.Description</textarea></div></div><div class="modal-footer"><button type="button" class="admin-btn admin-btn-outline" data-close-modal>Cancel</button><button class="admin-btn admin-btn-primary" type="submit">Save Changes</button></div></form></div></div>
<div class="modal-overlay hidden" id="category-details-@category.Id"><div class="modal modal-wide" role="dialog" aria-modal="true"><div class="modal-header"><h2>@category.NameEn Details</h2><button type="button" class="modal-close" data-close-modal>✕</button></div><div class="modal-body"><div class="category-details-intro"><span class="details-icon">@Icon(category.Slug)</span><div><h3>@category.NameEn</h3><p>@category.Description</p><span class="admin-badge @(category.IsActive ? "admin-badge-success" : "admin-badge-warning")">@(category.IsActive ? "Active" : "Inactive")</span></div></div><div class="subcategories-heading"><div><h3>Subcategories</h3><p>Manage groups inside this category.</p></div></div><div class="subcategories-list">@foreach (var sub in category.SubCategories) { <div class="subcategory-item"><div><strong>@sub.NameEn</strong><p>@sub.SkillCount skills · @sub.Slug</p></div><div class="subcategory-actions"><button type="button" data-open-modal="subcategory-edit-@sub.Id">✏️</button><form method="post" action="/Admin/subcategories/toggle">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@sub.Id"><button type="submit">@(sub.IsActive ? "Disable" : "Enable")</button></form></div></div> }</div><form method="post" action="/Admin/subcategories/save">@Html.AntiForgeryToken()<input type="hidden" name="CategoryId" value="@category.Id"><div class="form-group"><label class="form-label">New subcategory name</label><input class="form-input" name="NameEn" required maxlength="80"></div><div class="form-group"><label class="form-label">Slug</label><input class="form-input" name="Slug" required placeholder="subcategory-name" pattern="[a-z0-9]+(-[a-z0-9]+)*"></div><button class="admin-btn admin-btn-primary" type="submit">+ Add Subcategory</button></form></div><div class="modal-footer"><form method="post" action="/Admin/categories/toggle">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@category.Id"><button class="admin-btn admin-btn-outline" type="submit">@(category.IsActive ? "Deactivate Category" : "Activate Category")</button></form><button type="button" class="admin-btn admin-btn-outline" data-close-modal>Close</button></div></div></div>
@foreach (var sub in category.SubCategories) { <div class="modal-overlay hidden" id="subcategory-edit-@sub.Id"><div class="modal" role="dialog" aria-modal="true"><div class="modal-header"><h2>Edit @sub.NameEn</h2><button type="button" class="modal-close" data-close-modal>✕</button></div><form method="post" action="/Admin/subcategories/save">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@sub.Id"><input type="hidden" name="CategoryId" value="@category.Id"><div class="modal-body"><div class="form-group"><label class="form-label">Subcategory name</label><input class="form-input" name="NameEn" value="@sub.NameEn" required></div><div class="form-group"><label class="form-label">Slug</label><input class="form-input" name="Slug" value="@sub.Slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*"></div></div><div class="modal-footer"><button type="button" class="admin-btn admin-btn-outline" data-close-modal>Cancel</button><button class="admin-btn admin-btn-primary" type="submit">Save Changes</button></div></form></div></div> }
}
<script src="../admin-js/admin-shared.js"></script><script src="../admin-js/auto-slug-fields.js"></script><script src="../admin-js/admin-categories-db.js"></script><script src="../../js/site-ar.js"></script><script src="../../js/site-preferences.js"></script><script src="../../js/interface-polish.js"></script>
