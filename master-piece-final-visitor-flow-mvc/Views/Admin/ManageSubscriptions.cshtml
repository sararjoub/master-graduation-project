@model AdminSubscriptionsViewModel
@section Head {<meta name="viewport" content="width=device-width,initial-scale=1"><title>Subscriptions - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-mange-users.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="admin-content"><div class="admin-page-header"><div><h1>Subscriptions</h1><p>Membership state from the database; cancelling preserves payment history.</p></div></div><div class="admin-stats-grid"><div class="admin-stat-card"><strong>@Model.Active</strong><span>Active</span></div><div class="admin-stat-card"><strong>@Model.PastDue</strong><span>Past due</span></div><div class="admin-stat-card"><strong>@Model.Cancelled</strong><span>Cancelled</span></div></div>@if(TempData["AdminMessage"] is string msg){<div class="admin-alert admin-alert-success">@msg</div>}<div class="admin-card"><form class="admin-card-body" method="get">
<label for="membership-search">Search</label><input id="membership-search" class="form-input" name="search" value="@Context.Request.Query["search"]">
<label for="membership-status">Status</label><select id="membership-status" class="form-input" name="status"><option value="">All</option>
@foreach (var status in Enum.GetValues<SubscriptionStatus>()) { <option value="@status" selected="@(Context.Request.Query["status"] == status.ToString())">@status</option> }
</select><button class="admin-btn admin-btn-outline" type="submit">Filter</button></form><div class="admin-table-wrapper"><table class="admin-table"><thead><tr><th>Member</th><th>Plan</th><th>Status</th><th>Period</th><th>Auto renew</th><th>Action</th></tr></thead><tbody>@foreach(var item in Model.Subscriptions){<tr><td><a href="?id=@item.Id"><strong>@item.UserName</strong></a><br><small>@item.Email</small></td><td>@item.Plan</td><td>@item.Status</td><td>@item.Starts.ToLocalTime().ToString("dd MMM yyyy") – @item.Ends.ToLocalTime().ToString("dd MMM yyyy")</td><td>@(item.AutoRenew?"Yes":"No")</td><td>@if(item.Status == SubscriptionStatus.Active){<form method="post" action="/Admin/subscriptions/cancel">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"><button class="admin-btn admin-btn-outline" type="submit">Cancel</button></form>}</td></tr>}</tbody></table></div>@if(Model.Subscriptions.Count==0){<div class="admin-card-body">No subscriptions have been created yet.</div>}</div></div></main></div><script src="../admin-js/admin-shared.js"></script>
