@model SkillFormViewModel
@section Head {<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>@(Model.Id == 0 ? "Add" : "Edit") Skill - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-workflow-ui.css"><link rel="stylesheet" href="../admin-css/admin-skill-form.css"><script src="../../js/site-preferences-init.js"></script><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css"><link rel="stylesheet" href="../../css/interface-polish.css">}
<div class="admin-layout"><div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div><aside class="admin-sidebar" id="adminSidebar"><button class="admin-sidebar-dismiss" type="button" data-admin-close aria-label="Close sidebar">×</button><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol"><svg data-brand-mark viewBox="0 0 24 24" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="2"><path d="M7 10L3 14L7 18M3 14H15M17 6L21 10L17 14M21 10H9"/></g></svg></span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")<div class="admin-sidebar-footer"><a class="admin-sidebar-link" href="admin-profile.html">Admin account</a><button class="admin-sidebar-logout" id="adminLogout" type="button">Log out</button></div></aside>
<main class="admin-main"><button type="button" class="admin-mobile-menu" id="adminSidebarToggle">☰</button><div class="wf-admin-content"><div class="wf-header"><span class="wf-kicker">Administration</span><h1>@(Model.Id == 0 ? "Add a new skill" : "Edit skill")</h1><p>Define the skill, catalogue location, level, and access tier.</p></div><section class="wf-card"><h2>Skill details</h2><form method="post" action="/Admin/skills/save"><input type="hidden" asp-for="Id">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="wf-errors" role="alert"></div><div class="form-group"><label class="form-label" asp-for="NameEn">Name</label><input class="form-input" asp-for="NameEn" required maxlength="120"></div><div class="form-group"><label class="form-label" asp-for="Slug">Slug</label><input class="form-input" asp-for="Slug" required placeholder="skill-name" pattern="[a-z0-9]+(-[a-z0-9]+)*"></div><div class="form-group"><label class="form-label" asp-for="SubCategoryId">Category / Subcategory</label><select class="form-input" asp-for="SubCategoryId" required><option value="">Choose subcategory</option>@foreach (var option in Model.SubCategories) { <option value="@option.Id">@option.CategoryName — @option.Name</option> }</select></div><div class="form-group"><label class="form-label" asp-for="Level">Level</label><select class="form-input" asp-for="Level" asp-items="Html.GetEnumSelectList<SkillLevel>()"></select></div><div class="form-group"><label class="form-label" asp-for="AccessTier">Access tier</label><select class="form-input" asp-for="AccessTier" asp-items="Html.GetEnumSelectList<AccessTier>()"></select></div><div class="form-group"><label class="form-label" asp-for="Status">Publication status</label><select class="form-input" asp-for="Status" asp-items="Html.GetEnumSelectList<PublicationStatus>()"></select></div><div class="form-group"><label class="form-label" asp-for="Description">Description and learning goals</label><textarea class="form-textarea" asp-for="Description" rows="4" required minlength="10" maxlength="1500"></textarea></div><p class="wf-note">Free skills are available to all members. Plus skills require an active Plus subscription.</p><div class="form-actions"><a class="btn btn-outline" href="manage-skills.html">Cancel</a><button class="btn btn-primary" type="submit">Save Skill</button></div></form></section></div></main></div>
<script src="../admin-js/admin-shared.js"></script><script src="../admin-js/auto-slug-fields.js"></script><script src="../../js/site-preferences.js"></script><script src="../../js/interface-polish.js"></script>
