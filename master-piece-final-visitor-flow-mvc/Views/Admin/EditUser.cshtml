@model AdminUserStatusFormViewModel
@section Head {<meta name="viewport" content="width=device-width, initial-scale=1"><title>Edit member - Skills Swap Admin</title><link rel="stylesheet" href="../../css/shared.css"><link rel="stylesheet" href="../admin-css/admin-shared.css"><link rel="stylesheet" href="../admin-css/admin-edit-user.css"><link rel="stylesheet" href="../../css/responsive-refinements.css"><link rel="stylesheet" href="../../css/brand.css">}
<div class="admin-layout"><aside class="admin-sidebar" id="adminSidebar"><a href="dashboard.html" class="admin-sidebar-logo"><span class="brand-symbol">⇄</span><span class="brand-text"><span class="brand-wordmark">Skills <span>Swap</span></span><span class="brand-subtitle">Admin workspace</span></span></a>@await Html.PartialAsync("_Navigation3")</aside><main class="admin-main"><div class="wf-admin-content"><div class="wf-header"><span class="wf-kicker">Admin Panel</span><h1>Edit account status</h1><p>Passwords, subscriptions and expert approval use separate workflows.</p></div><section class="wf-card"><h2>@Model.FullName</h2><p>@Model.Email</p><form method="post" action="/Admin/users/status">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"><input asp-for="FullName" type="hidden"><input asp-for="Email" type="hidden"><div asp-validation-summary="ModelOnly" class="wf-errors"></div><div class="form-group"><label class="form-label" asp-for="Status">Account status</label><select class="form-input" asp-for="Status" asp-items="Html.GetEnumSelectList<AccountStatus>()"></select></div><div class="form-group"><label class="form-label" asp-for="Reason">Documented reason</label><textarea class="form-textarea" asp-for="Reason" rows="4" placeholder="Explain why this status is being changed..."></textarea><span asp-validation-for="Reason"></span></div><button class="btn btn-primary" type="submit">Save account status</button><a class="btn" href="user-details.html?id=@Model.Id">Cancel</a></form><div class="wf-note">Expert approval is never granted here. Use Expert applications.</div></section></div></main></div><script src="../admin-js/admin-shared.js"></script>
