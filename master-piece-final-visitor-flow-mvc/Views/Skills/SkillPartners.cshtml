@model SkillDiscoveryViewModel
@section Head { <meta name="viewport" content="width=device-width, initial-scale=1"><title>Learn @Model.SkillName - Skills Swap</title><link rel="stylesheet" href="/css/shared.css"><link rel="stylesheet" href="/css/partners.css"><script src="/js/site-preferences-init.js"></script><link rel="stylesheet" href="/css/site-preferences.css"><link rel="stylesheet" href="/css/responsive-refinements.css"><link rel="stylesheet" href="/css/brand.css"><link rel="stylesheet" href="/css/interface-polish.css"> }
@await Html.PartialAsync("_Navigation")
<main class="partners-section"><div class="container discovery-shell">
<nav class="discovery-breadcrumb" aria-label="Breadcrumb"><a href="/categories.html">Categories</a><span>/</span><a href="/category-overview.html?slug=@Uri.EscapeDataString(Model.CategorySlug)">@Model.CategoryName</a><span>/</span><a href="/sub-category.html?slug=@Uri.EscapeDataString(Model.SubCategorySlug)">@Model.SubCategoryName</a><span>/</span><span aria-current="page">@Model.SkillName</span></nav>
<header class="partners-header animate-fade-rise"><span class="discovery-eyebrow">Learning options</span><h1>Learn @Model.SkillName</h1><p>Choose free peer learning or explore skill-specific verified experts. Every result is an active, confirmed Skill Swap member.</p></header>
<section class="learning-choice-grid" aria-label="Learning options">
<article class="learning-choice-card peer-choice"><span class="choice-icon">↔</span><div><span class="choice-label">Free for Basic and Plus</span><h2>Learn with a Partner</h2><p>Learn from a member who teaches this skill. No reciprocal exchange is required.</p></div><span class="result-pill">@Model.PartnerCount partners</span></article>
<article class="learning-choice-card expert-choice"><span class="choice-icon">✓</span><div><span class="choice-label">Verified for @Model.SkillName</span><h2>Learn with an Expert</h2><p>View approved experts. Future booking will require Plus and session credits.</p></div><span class="result-pill">@Model.ExpertCount experts</span></article>
</section>
<form class="discovery-filters" method="get" action="/skill-partners.html" aria-label="Filter results"><input type="hidden" name="skillSlug" value="@Model.SkillSlug">
<div class="filter-field filter-search"><label for="search">Search by name</label><input id="search" name="search" value="@Model.Search" placeholder="Search members…"></div>
<div class="filter-field"><label for="level">Teaching level</label><select id="level" name="level"><option value="">All levels</option>@foreach(var level in Enum.GetValues<SkillLevel>()){<option value="@level" selected="@(Model.Level==level)">@level</option>}</select></div>
<div class="filter-field"><label for="sort">Sort by</label><select id="sort" name="sort">@foreach(var sort in Enum.GetValues<DiscoverySort>()){<option value="@sort" selected="@(Model.Sort==sort)">@sort</option>}</select></div>
<button class="btn btn-primary" type="submit">Apply filters</button>@if(Model.HasFilters){<a class="btn btn-outline" href="/skill-partners.html?skillSlug=@Uri.EscapeDataString(Model.SkillSlug)">Clear</a>}</form>

<section class="discovery-results" aria-labelledby="partners-heading"><div class="section-heading"><div><span class="section-kicker">Community learning</span><h2 id="partners-heading">Learning partners</h2></div><p>@Model.PartnerCount eligible members</p></div>
@if(Model.Partners.Count>0){<div class="discovery-card-grid">@foreach(var person in Model.Partners){@await Html.PartialAsync("_DiscoveryPersonCard",person)}</div>
@if(Model.TotalPages>1){<nav class="discovery-pagination" aria-label="Partner pages">@for(var pageNumber=1;pageNumber<=Model.TotalPages;pageNumber++){<a class="@(pageNumber==Model.Page?"active":null)" aria-current="@(pageNumber==Model.Page?"page":null)" href="/skill-partners.html?skillSlug=@Uri.EscapeDataString(Model.SkillSlug)&search=@Uri.EscapeDataString(Model.Search??"")&level=@Model.Level&sort=@Model.Sort&page=@pageNumber">@pageNumber</a>}</nav>}}
else{<div class="discovery-empty" role="status"><span>⌕</span><h3>@(Model.HasFilters?"No partners match these filters":"No learning partners are available yet")</h3><p>@(Model.HasFilters?"Clear or adjust the filters while keeping this skill selected.":"Check verified experts, explore related skills, or return to the catalogue.")</p><div class="empty-actions">@if(Model.HasFilters){<a class="btn btn-primary" href="/skill-partners.html?skillSlug=@Uri.EscapeDataString(Model.SkillSlug)">Clear filters</a>}<a class="btn btn-outline" href="/categories.html">Browse catalogue</a></div></div>}</section>

<section class="discovery-results expert-results" aria-labelledby="experts-heading"><div class="section-heading"><div><span class="section-kicker">Premium booking option</span><h2 id="experts-heading">Verified experts</h2></div><p>Approval is specific to @Model.SkillName</p></div>
@if(Model.Experts.Count>0){<div class="discovery-card-grid">@foreach(var expert in Model.Experts){@await Html.PartialAsync("_DiscoveryPersonCard",expert)}</div>}
else{<div class="discovery-empty compact" role="status"><span>✓</span><h3>No verified experts are available</h3><p>Peer learning remains free. Expert approval and Plus membership are separate.</p></div>}</section>
@if(Model.RelatedSkills.Count>0){<section class="related-discovery"><div class="section-heading"><div><span class="section-kicker">Keep exploring</span><h2>Related skills</h2></div></div><div class="related-skill-links">@foreach(var related in Model.RelatedSkills){<a href="/skill-details.html?slug=@Uri.EscapeDataString(related.Slug)">@related.Name <span>→</span></a>}</div></section>}
</div></main>
@await Html.PartialAsync("_Footer2")
<script src="/js/animations.js"></script><script src="/js/site-ar.js"></script><script src="/js/site-preferences.js"></script><script src="/js/icon-tones.js"></script><script src="/js/interface-polish.js"></script>
