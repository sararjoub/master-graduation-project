@model CategoriesPageViewModel
@functions {
    private static string CategoryIcon(string slug) => slug switch
    {
        "education" => "🎓",
        "technology" => "💻",
        "handmade" => "🎨",
        "entertainment" => "🎬",
        "business" => "💼",
        "health-fitness" => "❤️",
        _ => "📚"
    };
}
@section Head {
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - Skills Swap</title>

    <link rel="stylesheet" href="css/shared.css">
    <link rel="stylesheet" href="css/categories.css">
<script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}


    <!--  Navbar (Authed)  -->
    <nav class="navbar navbar-authed">
        <div class="navbar-container">
            <a href="home.html" class="navbar-logo"><span class="brand-symbol"><svg data-brand-mark viewBox="0 0 24 24" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10L3 14L7 18M3 14H15M17 6L21 10L17 14M21 10H9"/></g></svg></span><span class="brand-text"><span class="brand-wordmark" data-no-translate>Skills <span>Swap</span></span></span></a>
            <div class="navbar-links">
                <a href="dashboard.html" class="navbar-link">Dashboard</a>
                <a href="categories.html" class="navbar-link active">Categories</a>
                <a href="career-path.html" class="navbar-link">Career Path</a>
                <a href="skill-partners.html" class="navbar-link">Find Partners</a>
            </div>
            <div class="navbar-actions">
                @if (Model.IsAuthenticated)
                {
                    <button class="navbar-icon-btn" id="messagesBtn" title="Messages">💬</button>
                    <div class="navbar-user" id="userMenu">
                        <button class="navbar-avatar" id="avatarBtn"><span>@Model.CurrentUserInitials</span></button>
                        <div class="user-dropdown" id="userDropdown">
                            <div class="dropdown-header">
                                <div class="avatar avatar-md"><span>@Model.CurrentUserInitials</span></div>
                                <div>
                                    <strong>@Model.CurrentUserFullName</strong>
                                    <span>@Model.CurrentUserEmail</span>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="profile.html" class="dropdown-item"><span class="dropdown-icon">👤</span> My Profile</a>
                            <a href="dashboard.html" class="dropdown-item"><span class="dropdown-icon">📊</span> Dashboard</a>
                            <a href="my-skills.html" class="dropdown-item"><span class="dropdown-icon">🎯</span> My Skills</a>
                            <a href="swap-requests.html" class="dropdown-item"><span class="dropdown-icon">🔄</span> Swap Requests</a>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item dropdown-logout" id="logoutBtn"><span class="dropdown-icon">🚪</span> Logout</button>
                        </div>
                    </div>
                }
                else
                {
                    <a class="navbar-login" href="/login.html">Login</a>
                    <a class="navbar-signup" href="/signup.html">Sign Up</a>
                }
            </div>
        </div>
    </nav>

    <!--  Categories Section  -->
    <section class="categories-section">
        <div class="container">

            <!-- Header -->
            <div class="categories-header animate-fade-rise">
                <span class="categories-tag">EXPLORE SKILLS</span>
                <h1>Browse All Categories</h1>
                <p>Discover skills and connect with people who can teach and learn with you.</p>
            </div>

            <!-- Search -->
            <div class="categories-search animate-fade-rise-delay-1">
                <input 
                    type="text" 
                    class="search-input" 
                    placeholder="Search categories..."
                    id="searchInput"
                >
            </div>

            <!-- Categories Grid -->
            <div class="categories-grid stagger-children" id="categoriesGrid">
                @foreach (var category in Model.Categories)
                {
                    <a href="/category-overview.html?slug=@Uri.EscapeDataString(category.Slug)" class="category-card" data-name="@category.Slug">
                        <div class="category-icon category-icon-@category.Slug">@CategoryIcon(category.Slug)</div>
                        <h3 class="category-name">@category.Name</h3>
                        <p class="category-desc">@(string.IsNullOrWhiteSpace(category.Description) ? $"Explore {category.SkillCount} published skills" : category.Description)</p>
                        <div class="category-arrow">→</div>
                    </a>
                }
            </div>

            <!-- Empty State -->
            <div class="empty-state @(Model.Categories.Count == 0 ? string.Empty : "hidden")" id="emptyState">
                <div class="empty-icon">🔍</div>
                <h3>No categories found</h3>
                <p>Try a different search term.</p>
            </div>

        </div>
    </section>
<!--  FOOTER -->
@await Html.PartialAsync("_Footer2")
    <script src="js/animations.js"></script>
    <script src="js/categories.js"></script>

<script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
<script src="js/icon-tones.js"></script>
<script src="js/interface-polish.js"></script>
