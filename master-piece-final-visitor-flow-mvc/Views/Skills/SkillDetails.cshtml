@model SkillDetailsViewModel
@section Head {
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>@Model.Name - Skills Swap</title>
<link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/details.css"><script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css"><link rel="stylesheet" href="css/responsive-refinements.css"><link rel="stylesheet" href="css/brand.css"><link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg"><link rel="stylesheet" href="css/interface-polish.css">
}
@await Html.PartialAsync("_Navigation")
<section class="skill-details-section"><div class="container"><div class="breadcrumb animate-fade-rise"><a href="/home.html">Home</a><span class="separator">/</span><a href="/categories.html">Categories</a><span class="separator">/</span><a href="/category-overview.html?slug=@Uri.EscapeDataString(Model.CategorySlug)">@Model.CategoryName</a><span class="separator">/</span><a href="/sub-category.html?slug=@Uri.EscapeDataString(Model.SubCategorySlug)">@Model.SubCategoryName</a><span class="separator">/</span><span class="current">@Model.Name</span></div>
<div class="skill-details-grid"><div class="skill-main animate-fade-rise-delay-1"><div class="skill-header"><h1 class="skill-title">@Model.Name</h1><div class="skill-badges"><span class="badge badge-primary">@Model.CategoryName</span><span class="badge badge-info">@Model.Level</span><span class="badge @(Model.AccessTier == AccessTier.Plus ? "badge-warning" : "badge-success")">@Model.AccessTier</span></div><p class="skill-intro">@Model.Description</p></div>
<div class="skill-section"><h2>About</h2><p>@Model.Description</p></div>
@if (Model.AccessTier == AccessTier.Plus) { <div class="premium-lock-banner"><div class="premium-lock-icon">🔒</div><div class="premium-lock-content"><h3>Advanced skill · Plus</h3><p>Starting this advanced skill requires an active Plus subscription.</p></div><a href="/pricing.html" class="btn btn-primary">View Plus →</a></div> }
<div class="skill-actions">@if (Model.IsAuthenticated) { <a class="btn btn-primary btn-large" href="/skill-partners.html?skillSlug=@Uri.EscapeDataString(Model.Slug)">Explore learning options →</a><p class="learning-action-note">Choose free peer learning or view verified experts for this skill.</p> } else { <a class="btn btn-primary btn-large" href="/login.html?returnUrl=@Uri.EscapeDataString($"/skill-details.html?slug={Model.Slug}")">Login to start learning →</a> }</div>
<div class="skill-section"><h2>Related Skills</h2>@if (Model.RelatedSkills.Count == 0) { <p>No related published skills are available yet.</p> } else { <div class="related-skills">@foreach (var related in Model.RelatedSkills) { <a class="related-skill-tag" href="/skill-details.html?slug=@Uri.EscapeDataString(related.Slug)">@related.Name</a> }</div> }</div></div>
<aside class="skill-sidebar animate-slide-in-right"><div class="skill-illustration"><img src="assests/brand-mark.svg" alt="@Model.Name"></div><div class="learning-path-card"><h3>Skill information</h3><div class="path-level"><div class="path-header"><span class="path-level-name">Level</span><span class="badge badge-info">@Model.Level</span></div></div><div class="path-level"><div class="path-header"><span class="path-level-name">Access</span><span class="badge @(Model.AccessTier == AccessTier.Plus ? "badge-warning" : "badge-success")">@Model.AccessTier</span></div></div><div class="requirements"><h4>Category</h4><ul class="requirements-list"><li>@Model.CategoryName</li><li>@Model.SubCategoryName</li></ul></div></div></aside></div></div></section>
@await Html.PartialAsync("_Footer2")
<script src="js/animations.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script><script src="js/icon-tones.js"></script><script src="js/interface-polish.js"></script>
