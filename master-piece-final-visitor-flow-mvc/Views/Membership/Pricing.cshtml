@model MembershipPage
@{
    var eligible = ViewData["EligibleMember"] is true;
    string Checkout(BillingPeriod period)
    {
        var route = $"/subscription-checkout.html?period={period}";
        return eligible ? route : Url.Action("Login", "Account", new { returnUrl = route })!;
    }
}
@section Head {
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Membership - Skills Swap</title>
<link rel="stylesheet" href="/css/shared.css">
<link rel="stylesheet" href="/css/site-preferences.css">
<link rel="stylesheet" href="/css/responsive-refinements.css">
<link rel="stylesheet" href="/css/brand.css">
<link rel="stylesheet" href="/css/interface-polish.css">
<link rel="stylesheet" href="/css/membership.css" asp-append-version="true">
<script src="/js/site-preferences-init.js"></script>
}
@await Html.PartialAsync("_Navigation")
<main class="membership-page">
<header class="membership-intro">
    <h1>Start learning with Basic. Go further with Plus.</h1>
    <p>Start for free with peer learning. Upgrade when you want access to advanced skills.</p>
</header>
<section aria-label="Membership plans" class="membership-plans">
    <fieldset class="membership-cycle">
        <legend>Billing period</legend>
        <label><input type="radio" name="pricing-period" value="Monthly" checked="@(Model.Period == BillingPeriod.Monthly)"> <span>Monthly</span></label>
        <label><input type="radio" name="pricing-period" value="Yearly" checked="@(Model.Period == BillingPeriod.Yearly)"> <span>Yearly</span></label>
    </fieldset>
    <div class="membership-grid">
        <article class="membership-card">
            <h2>Basic</h2><p>Explore free skills and learn with peers.</p>
            <div class="membership-basic-price"><p class="membership-price">Free</p></div>
            <ul><li>Free skills</li><li>Peer learning, video meetings and chat</li><li>Session reviews</li></ul>
            @if (!User.Identity!.IsAuthenticated) { <a href="/signup.html" class="btn btn-outline">Create a free account</a> }
            else if (eligible && Model.Current is null) { <p><strong>Current membership</strong></p> }
        </article>
        <article class="membership-card membership-plus">
            <h2>Plus</h2><p>Learn advanced skills and keep all Basic benefits.</p>
            @if (Model.Plus is { } plan)
            {
                var savings = plan.MonthlyPrice > 0 ? (plan.MonthlyPrice * 12 - plan.YearlyPrice) : 0;
                <div class="membership-period monthly"><p class="membership-price"><bdi>@plan.MonthlyPrice.ToString("0.00") USD</bdi></p><span>Billed monthly</span></div>
                <div class="membership-period yearly"><p class="membership-price"><bdi>@plan.YearlyPrice.ToString("0.00") USD</bdi></p><span>Billed yearly</span>
                <p><span>Equivalent per month</span> <bdi>@((plan.YearlyPrice / 12).ToString("0.00")) USD</bdi></p>
                @if (savings > 0) { <p class="membership-savings"><span>Annual savings</span> <bdi>@savings.ToString("0.00") USD · @((savings / (plan.MonthlyPrice * 12)).ToString("P1"))</bdi></p> }</div>
                <ul><li>Advanced skills</li><li><bdi>@plan.MonthlyExpertCredits</bdi> <span>expert credits per month when booking launches</span></li>
                    <li>Additional expert sessions when booking launches</li></ul>
                @if (Model.Current is { } current)
                {
                    <p><strong>Current membership</strong> · <span>@current.BillingPeriod</span> · <span>Expires</span> @await Html.PartialAsync("_LocalDate", current.EndsAtUtc)</p>
                    <p><a href="/subscription.html">Manage subscription</a></p>
                }
                else if (Model.Latest?.EndsAtUtc <= Model.Now) { <p>Plus has expired.</p> }
                @if (Model.DemoEnabled && (eligible || !User.Identity!.IsAuthenticated))
                {
                    var action = !eligible ? "Log in to choose Plus" : Model.Latest is null ? "Upgrade to Plus" : "Renew Plus";
                    <div class="membership-actions"><a class="btn btn-primary membership-period monthly" href="@Checkout(BillingPeriod.Monthly)">@action</a>
                    <a class="btn btn-primary membership-period yearly" href="@Checkout(BillingPeriod.Yearly)">@action</a>
                    </div>
                }
            }
            else { <p>Plus is currently unavailable.</p> }
        </article>
    </div>
</section>
<section class="membership-card membership-section" id="compare-memberships">
    <h2>Compare memberships</h2>
    <table class="membership-comparison">
        <thead><tr><th scope="col">Feature</th><th scope="col">Basic</th><th scope="col">Plus</th></tr></thead>
        <tbody>
        <tr><th scope="row">Free skills and peer learning</th><td>Included</td><td>Included</td></tr>
        <tr><th scope="row">Video meetings, chat and reviews</th><td>Included</td><td>Included</td></tr>
        <tr><th scope="row">Advanced skills</th><td>—</td><td>Included</td></tr>
        <tr><th scope="row">AI career paths and free learning stages</th><td>Planned</td><td>Planned</td></tr>
        <tr><th scope="row">Advanced learning stages</th><td>—</td><td>Planned</td></tr>
        <tr><th scope="row">Expert booking and expert applications</th><td>—</td><td>Planned</td></tr>
        <tr><th scope="row">Monthly expert credits for future bookings</th><td>—</td><td>@(Model.Plus?.MonthlyExpertCredits.ToString() ?? "—")</td></tr>
        </tbody>
    </table>
</section>
<section class="membership-card membership-section">
    <h2>How expert credits work</h2>
    <ol class="membership-steps">
        <li><strong>Receive credits</strong><p>Plus includes credits each month, even with yearly billing.</p></li>
        <li><strong>Use one per booking</strong><p>Each included expert session will use one credit when booking launches.</p></li>
        <li><strong>Start fresh each month</strong><p>Unused credits expire. Extra sessions will be available for purchase.</p></li>
    </ol>
    @if (Model.Plus is { } creditPlan)
    {
        <p><strong>@creditPlan.MonthlyExpertCredits</strong> <span>credits per month</span> · <strong><bdi>@creditPlan.AdditionalExpertPrice.ToString("0.00") USD</bdi></strong> <span>per additional session when booking launches</span></p>
    }
</section>
<section class="membership-card membership-section">
    <h2>Frequently asked questions</h2>
    <details><summary>What is the difference between Basic and Plus?</summary><p>Basic includes free skills and peer learning. Plus also unlocks advanced skills.</p></details>
    <details><summary>How do expert credits work?</summary><p>One included expert session will use one credit after booking launches.</p></details>
    <details><summary>How does annual billing work?</summary><p>Pay once for a calendar year. Credit periods still renew monthly.</p></details>
    <details><summary>Do unused credits carry forward?</summary><p>Unused credits expire at the end of each credit period.</p></details>
    <details><summary>What happens when Plus expires?</summary><p>Basic access resumes. Your history and accepted sessions remain available.</p></details>
    <details><summary>How can I renew?</summary><p>Choose a renewal from your membership page. An early renewal starts at the end of your paid access.</p></details>
    <details><summary>Are payments simulated?</summary><p>Simulated payments use no real money or card details. Renewals are manual.</p></details>
</section>
</main>
@await Html.PartialAsync("_Footer2")
<script src="/js/site-ar.js"></script>
<script src="/js/membership-ar.js" asp-append-version="true"></script>
<script src="/js/site-preferences.js"></script>
<script src="/js/animations.js"></script>
<script src="/js/icon-tones.js"></script>
<script src="/js/membership-dates.js" asp-append-version="true"></script>
