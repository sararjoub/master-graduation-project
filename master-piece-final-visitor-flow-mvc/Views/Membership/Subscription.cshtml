@model MembershipPage
@section Head {
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Manage subscription - Skills Swap</title>
<link rel="stylesheet" href="/css/shared.css">
<link rel="stylesheet" href="/css/site-preferences.css">
<link rel="stylesheet" href="/css/responsive-refinements.css">
<link rel="stylesheet" href="/css/brand.css">
<link rel="stylesheet" href="/css/interface-polish.css">
<link rel="stylesheet" href="/css/membership.css" asp-append-version="true">
<script src="/js/site-preferences-init.js"></script>
}
@await Html.PartialAsync("_Navigation")
<main class="membership-page">
<header class="membership-intro"><h1>Manage subscription</h1></header>
<div class="membership-grid">
    <section class="membership-card">
        <h2>Current membership</h2>
        @if (Model.Current is { } current)
        {
            <p><strong>Plus</strong> <span class="membership-badge membership-status-paid">Active</span></p>
            <dl class="membership-summary">
                <dt>Billing period</dt><dd>@current.BillingPeriod</dd>
                <dt>Access starts</dt><dd>@await Html.PartialAsync("_LocalDate", current.StartsAtUtc)</dd>
                <dt>Expires</dt><dd>@await Html.PartialAsync("_LocalDate", current.EndsAtUtc)</dd>
                <dt>Days remaining</dt><dd>@Math.Ceiling((current.EndsAtUtc - Model.Now).TotalDays)</dd>
            </dl>
        }
        else
        {
            <p><strong>Basic</strong></p>
            @if (Model.Latest?.EndsAtUtc <= Model.Now) { <p>Plus has expired.</p> }
        }
        <div class="membership-actions">
            @if (Model.DemoEnabled && Model.Plus is not null)
            {
                <a href="/pricing.html?period=@(Model.Current?.BillingPeriod ?? Model.Latest?.BillingPeriod ?? Model.Period)" class="btn btn-primary">@(Model.Latest is null ? "Upgrade to Plus" : "Renew subscription")</a>
            }
            <a href="/pricing.html#compare-memberships" class="btn btn-outline">Compare memberships</a>
        </div>
    </section>
    <section class="membership-card">
        <h2>Expert credits</h2>
        @if (Model.Credits is { } credits)
        {
            <p><span>Available credits</span> <strong>@credits.Remaining / @credits.Allocated</strong></p>
            <meter class="membership-meter" min="0" max="@Math.Max(1, credits.Allocated)" value="@credits.Remaining" aria-label="Available credits"></meter>
            var next = Model.Current!.EndsAtUtc > credits.EndsAtUtc ? credits.EndsAtUtc : Model.Future.FirstOrDefault()?.StartsAtUtc;
            <dl class="membership-summary">
                <dt>Credit period starts</dt><dd>@await Html.PartialAsync("_LocalDate", credits.StartsAtUtc)</dd>
                <dt>Credit expiration</dt><dd>@await Html.PartialAsync("_LocalDate", credits.EndsAtUtc)</dd>
                @if (next is DateTime date) { <dt>Next credit allocation</dt><dd>@await Html.PartialAsync("_LocalDate", date)</dd> }
            </dl>
        }
        else { <p>No current credit allocation.</p> }
        <p>Expert booking is planned.</p>
    </section>
</div>
@if (Model.Future.Count > 0)
{
    <section class="membership-card membership-section"><h2>Upcoming paid renewals</h2>
        <ul>@foreach (var future in Model.Future)
        {
            <li><span>@future.BillingPeriod</span> · @await Html.PartialAsync("_LocalDate", future.StartsAtUtc) – @await Html.PartialAsync("_LocalDate", future.EndsAtUtc)</li>
        }</ul>
    </section>
}
<section class="membership-card membership-section">
    <h2>Subscription and payment history</h2>
    @if (Model.History.Count == 0) { <p>No transactions yet.</p> }
    else
    {
        <ul class="membership-transaction-list">
        @foreach (var payment in Model.History)
        {
            <li>
                <div class="membership-transaction-header"><strong>Plus · <span>@payment.Subscription.BillingPeriod</span></strong>
                    <span class="membership-badge membership-status-@payment.Status.ToString().ToLowerInvariant()">@payment.Status</span></div>
                <dl class="membership-summary">
                    <dt>Total payment</dt><dd><bdi>@payment.Amount.ToString("0.00") @payment.Currency</bdi></dd>
                    <dt>Transaction date</dt><dd>@await Html.PartialAsync("_LocalDate", payment.CreatedAtUtc)</dd>
                    @if (payment.Status == PaymentStatus.Paid)
                    {
                        <dt>Access period</dt><dd>@await Html.PartialAsync("_LocalDate", payment.Subscription.StartsAtUtc) – @await Html.PartialAsync("_LocalDate", payment.Subscription.EndsAtUtc)</dd>
                    }
                </dl>
                @if (payment.Provider == SkillsSwap.Services.SimulatedPaymentGateway.ProviderName)
                {
                    <a href="/subscription-payment.html?reference=@payment.ProviderReference">View simulated transaction</a>
                }
            </li>
        }
        </ul>
    }
</section>
</main>
@await Html.PartialAsync("_Footer2")
<script src="/js/site-ar.js"></script>
<script src="/js/membership-ar.js" asp-append-version="true"></script>
<script src="/js/site-preferences.js"></script>
<script src="/js/animations.js"></script>
<script src="/js/icon-tones.js"></script>
<script src="/js/membership-dates.js" asp-append-version="true"></script>
