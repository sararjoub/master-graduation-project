@{
    ViewData["BodyClass"] = "wf-page";
}

@section Head {<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>My subscription - Skills Swap</title><link rel="stylesheet" href="css/shared.css"><link rel="stylesheet" href="css/subscription.css"><script src="js/site-preferences-init.js"></script><link rel="stylesheet" href="css/site-preferences.css">
<link rel="stylesheet" href="css/responsive-refinements.css">
<link rel="stylesheet" href="css/brand.css">
<link rel="icon" type="image/svg+xml" href="assests/brand-mark.svg">
<link rel="stylesheet" href="css/interface-polish.css">
<script src="js/visitor-flow.js"></script>
<script src="js/skill-access.js"></script>
}

@await Html.PartialAsync("_Navigation")
<main class="wf-section"><div class="wf-container"><div class="wf-header"><span class="wf-kicker">Skills Swap</span><h1>My subscription</h1><p>Example subscription details for interface review.</p></div><div class="wf-grid"><section class="wf-card"><h2>Example Plus account</h2><dl><dt>Plan</dt><dd>Plus · illustrative record</dd><dt>Monthly allowance</dt><dd>1 expert session</dd><dt>Unused credits</dt><dd>1 · example only</dd><dt>Renewal</dt><dd id="wf-renewal">Enabled · sample</dd></dl><form data-wf-form="cancel-renewal"><div class="wf-errors" role="alert"></div><div class="form-group"><label class="form-label" for="reason">Reason (optional)</label><textarea class="form-textarea" rows="4" id="reason" name="reason" maxlength="500"></textarea></div><button class="btn btn-primary" type="submit">Preview cancellation request</button><p class="wf-feedback" role="status" aria-live="polite"></p></form></section><section class="wf-card"><h2>Access and history</h2><p>Cancelling renewal keeps paid access until the period ends. New expert bookings require active Plus access; learning history and eligible confirmed bookings remain.</p><a href="pricing.html" class="btn btn-outline">Compare plans</a><div class="wf-note " role="note">No subscription is modified by this page. Monthly grants and credit returns require an authoritative server ledger.</div></section></div><div class="wf-note wf-muted" role="note">Frontend preview: sample data only. Actions update this page for review; no email, payment, AI service, or database is connected. Nothing is stored in the browser.</div></div></main>
@await Html.PartialAsync("_Footer2")
<script src="js/animations.js"></script><script src="js/workflow-ui.js"></script><script src="js/subscription.js"></script><script src="js/site-ar.js"></script><script src="js/site-preferences.js"></script>
