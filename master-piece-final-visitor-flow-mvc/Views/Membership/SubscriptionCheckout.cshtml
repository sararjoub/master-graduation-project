@model CheckoutPage
@section Head {
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Plus checkout - Skills Swap</title>
<link rel="stylesheet" href="/css/shared.css">
<link rel="stylesheet" href="/css/site-preferences.css">
<link rel="stylesheet" href="/css/responsive-refinements.css">
<link rel="stylesheet" href="/css/brand.css">
<link rel="stylesheet" href="/css/interface-polish.css">
<link rel="stylesheet" href="/css/membership.css" asp-append-version="true">
<script src="/js/site-preferences-init.js"></script>
}
@await Html.PartialAsync("_Navigation")
<main class="membership-page">
<header class="membership-intro"><h1>Plus checkout</h1><p>Review your membership and payment total.</p></header>
<div class="membership-grid">
    <section class="membership-card">
        <h2>Membership details</h2>
        <dl class="membership-summary">
            <dt>Plan</dt><dd>Plus</dd>
            <dt>Billing period</dt><dd>@Model.Period</dd>
            <dt>Duration</dt><dd>@(Model.Period == BillingPeriod.Yearly ? "One calendar year" : "One calendar month")</dd>
            <dt>Estimated start</dt><dd>@await Html.PartialAsync("_LocalDate", Model.StartsAt)</dd>
            <dt>Estimated expiration</dt><dd>@await Html.PartialAsync("_LocalDate", Model.EndsAt)</dd>
        </dl>
        <h3>Included benefits</h3>
        <ul><li>Advanced skills</li><li>Peer learning, video meetings and chat</li><li>@Model.Plan.MonthlyExpertCredits <span>credits per month for future bookings</span></li></ul>
    </section>
    <section class="membership-card membership-plus">
        <h2>Order summary</h2>
        <p>Total payment</p>
        <p class="membership-price"><bdi>@((Model.Period == BillingPeriod.Yearly ? Model.Plan.YearlyPrice : Model.Plan.MonthlyPrice).ToString("0.00")) USD</bdi></p>
        <p class="membership-demo-note">Simulated payment. No money will be charged.</p>
        @if (Model.DemoEnabled)
        {
            <form class="membership-actions" method="post" action="/subscription-checkout/quote">@Html.AntiForgeryToken()
                <input type="hidden" name="period" value="@Model.Period">
                <button class="btn btn-primary" type="submit">Continue to simulation</button>
            </form>
        }
        else { <p>Simulated payments are disabled.</p> }
        <a href="/pricing.html?period=@Model.Period">Back to pricing</a>
    </section>
</div>
</main>
@await Html.PartialAsync("_Footer2")
<script src="/js/site-ar.js"></script>
<script src="/js/membership-ar.js" asp-append-version="true"></script>
<script src="/js/site-preferences.js"></script>
<script src="/js/animations.js"></script>
<script src="/js/icon-tones.js"></script>
<script src="/js/membership-dates.js" asp-append-version="true"></script>
